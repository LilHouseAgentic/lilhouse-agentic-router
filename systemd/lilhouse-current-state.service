[Unit]
Description=LilHouse current state collector
Documentation=https://github.com/YOURNAME/lilhouse-agentic-router
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/lilhouse/lilhouse.env
Environment=LILHOUSE_COMMON=/usr/lib/lilhouse/lilhouse-common.sh
ExecStart=/usr/local/bin/lilhouse-current-state
User=root
Group=root
