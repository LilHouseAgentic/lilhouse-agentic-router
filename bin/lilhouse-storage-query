#!/usr/bin/env python3
import argparse
import gzip
import json
import os
from pathlib import Path
from datetime import datetime, timezone

DEFAULT_STATE_DIR = os.environ.get("LILHOUSE_STATE_DIR", "/var/lib/lilhouse")
DEFAULT_LOG_DIR = os.environ.get("LILHOUSE_LOG_DIR", "/var/log/lilhouse")
DEFAULT_ARCHIVE_DIR = os.environ.get("LILHOUSE_ARCHIVE_DIR", "/var/lib/lilhouse/archive")

ACTIVE_LEDGERS = {
    "events.jsonl",
    "actions.jsonl",
    "proposals.jsonl",
}

ACTIVE_STATE = {
    "current-state.json",
    "storage-health.json",
}


def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat()


def human_bytes(num):
    try:
        num = float(num)
    except Exception:
        return "unknown"

    units = ["B", "KB", "MB", "GB", "TB"]
    for unit in units:
        if abs(num) < 1024.0:
            if unit == "B":
                return f"{int(num)} {unit}"
            return f"{num:.1f} {unit}"
        num /= 1024.0
    return f"{num:.1f} PB"


def safe_stat(path):
    try:
        st = Path(path).stat()
        return {
            "exists": True,
            "bytes": st.st_size,
            "human": human_bytes(st.st_size),
            "mtime": datetime.fromtimestamp(st.st_mtime, timezone.utc).astimezone().isoformat(),
        }
    except Exception as exc:
        return {
            "exists": False,
            "bytes": 0,
            "human": "0 B",
            "mtime": None,
            "error": str(exc),
        }


def count_lines(path):
    p = Path(path)
    if not p.exists() or not p.is_file():
        return 0
    try:
        with p.open("r", encoding="utf-8", errors="replace") as f:
            return sum(1 for _ in f)
    except Exception:
        return None


def file_kind(path):
    name = Path(path).name
    if name.endswith(".jsonl.gz"):
        return "jsonl_gzip"
    if name.endswith(".json.gz"):
        return "json_gzip"
    if name.endswith(".log.gz") or name.endswith(".txt.gz"):
        return "text_gzip"
    if name.endswith(".jsonl"):
        return "jsonl"
    if name.endswith(".json"):
        return "json"
    if name.endswith(".log") or name.endswith(".txt"):
        return "text"
    if name.endswith(".gz"):
        return "gzip"
    return "file"


def infer_hot_role(path, state_dir, log_dir):
    p = Path(path)

    try:
        p.relative_to(log_dir)
        return "hot_log"
    except Exception:
        pass

    try:
        p.relative_to(state_dir)
        if p.name in ACTIVE_LEDGERS:
            return "hot_active_ledger"
        if p.name in ACTIVE_STATE:
            return "hot_latest_state"
        if p.name.endswith(".jsonl"):
            return "hot_jsonl_history"
        if p.name.endswith(".json"):
            return "hot_report"
        return "hot_state_file"
    except Exception:
        pass

    return "unknown"


def walk_files(root, exclude_names=None):
    root = Path(root)
    exclude_names = set(exclude_names or [])
    if not root.exists():
        return
    if root.is_file():
        if root.name not in exclude_names:
            yield root
        return

    for dirpath, dirs, files in os.walk(root, topdown=True):
        base = Path(dirpath)
        dirs[:] = [d for d in dirs if d not in {".git", "__pycache__"}]
        for name in files:
            if name in exclude_names:
                continue
            yield base / name


def record_from_hot_file(path, state_dir, log_dir):
    info = safe_stat(path)
    kind = file_kind(path)
    line_count = count_lines(path) if kind in {"jsonl", "text"} else None

    return {
        "schema": "lilhouse.storage_query_record.v1",
        "source": "hot_file",
        "path": str(path),
        "role": infer_hot_role(path, state_dir, log_dir),
        "kind": kind,
        "bytes": info["bytes"],
        "human": info["human"],
        "mtime": info["mtime"],
        "line_count": line_count,
        "agent_access": "direct_read",
    }


def record_from_archive_file(path, archive_dir):
    info = safe_stat(path)
    kind = file_kind(path)

    return {
        "schema": "lilhouse.storage_query_record.v1",
        "source": "archive_file",
        "path": str(path),
        "role": "archive_file",
        "kind": kind,
        "bytes": info["bytes"],
        "human": info["human"],
        "mtime": info["mtime"],
        "line_count": None,
        "agent_access": "gzip_then_parse" if Path(path).name.endswith(".gz") else "direct_read",
    }


def record_from_index_line(line, index_file, line_number):
    try:
        raw = json.loads(line)
    except Exception as exc:
        return {
            "schema": "lilhouse.storage_query_record.v1",
            "source": "archive_index",
            "index_file": str(index_file),
            "index_line": line_number,
            "role": "invalid_index_record",
            "kind": "invalid_json",
            "path": None,
            "error": str(exc),
            "agent_access": "unavailable",
        }

    raw_schema = raw.get("schema", "")

    if raw_schema == "lilhouse.storage_archive_action.v1":
        path = raw.get("archive_path") or raw.get("source_path")
        role = raw.get("role", "archive_action")
        kind = file_kind(path or "")
        return {
            "schema": "lilhouse.storage_query_record.v1",
            "source": "archive_index",
            "index_file": str(index_file),
            "index_line": line_number,
            "indexed_schema": raw_schema,
            "role": role,
            "kind": kind,
            "path": path,
            "source_path": raw.get("source_path"),
            "archive_path": raw.get("archive_path"),
            "bytes": raw.get("archive_bytes") or raw.get("source_bytes"),
            "human": human_bytes(raw.get("archive_bytes") or raw.get("source_bytes") or 0),
            "sha256": raw.get("archive_sha256") or raw.get("source_sha256"),
            "source_sha256": raw.get("source_sha256"),
            "archive_sha256": raw.get("archive_sha256"),
            "verified_payload_sha256_match": raw.get("verified_payload_sha256_match"),
            "deleted_source": raw.get("deleted_source"),
            "agent_access": raw.get("agent_access", "gzip_then_parse"),
        }

    if raw_schema == "lilhouse.storage_index_record.v1":
        path = raw.get("path")
        return {
            "schema": "lilhouse.storage_query_record.v1",
            "source": "archive_index",
            "index_file": str(index_file),
            "index_line": line_number,
            "indexed_schema": raw_schema,
            "role": raw.get("role", "storage_index_record"),
            "kind": raw.get("kind") or file_kind(path or ""),
            "path": path,
            "bytes": raw.get("bytes"),
            "human": raw.get("human") or human_bytes(raw.get("bytes") or 0),
            "mtime": raw.get("mtime"),
            "line_count": raw.get("line_count"),
            "sha256": raw.get("sha256"),
            "compressed": raw.get("compressed"),
            "agent_access": raw.get("agent_access", "direct_read"),
        }

    path = raw.get("path") or raw.get("archive_path") or raw.get("source_path")
    return {
        "schema": "lilhouse.storage_query_record.v1",
        "source": "archive_index",
        "index_file": str(index_file),
        "index_line": line_number,
        "indexed_schema": raw_schema or "unknown",
        "role": raw.get("role", "unknown_index_record"),
        "kind": raw.get("kind") or file_kind(path or ""),
        "path": path,
        "bytes": raw.get("bytes") or raw.get("archive_bytes") or raw.get("source_bytes"),
        "human": raw.get("human") or human_bytes(raw.get("bytes") or raw.get("archive_bytes") or raw.get("source_bytes") or 0),
        "agent_access": raw.get("agent_access", "unknown"),
    }


def read_index_records(archive_dir):
    index_file = Path(archive_dir) / "index.jsonl"
    if not index_file.exists():
        return []

    records = []
    with index_file.open("r", encoding="utf-8", errors="replace") as f:
        for idx, line in enumerate(f, start=1):
            line = line.strip()
            if not line:
                continue
            records.append(record_from_index_line(line, index_file, idx))
    return records


def collect_records(args):
    state_dir = Path(args.state_dir)
    log_dir = Path(args.log_dir)
    archive_dir = Path(args.archive_dir)

    records = []

    for p in walk_files(state_dir):
        if "archive" in p.parts or "archives" in p.parts:
            continue
        records.append(record_from_hot_file(p, state_dir, log_dir))

    for p in walk_files(log_dir):
        records.append(record_from_hot_file(p, state_dir, log_dir))

    for p in walk_files(archive_dir, exclude_names={"index.jsonl"}):
        records.append(record_from_archive_file(p, archive_dir))

    records.extend(read_index_records(archive_dir))

    records.sort(key=lambda r: (r.get("source", ""), r.get("role", ""), r.get("path") or ""))
    return records


def matches_type(record, type_filter):
    if type_filter in {"all", None}:
        return True

    role = record.get("role", "")
    kind = record.get("kind", "")
    source = record.get("source", "")

    if type_filter == "ledger":
        return "ledger" in role or kind in {"jsonl", "jsonl_gzip"}
    if type_filter == "archive":
        return source in {"archive_file", "archive_index"} or role.startswith("archive")
    if type_filter == "hot":
        return source == "hot_file"
    if type_filter == "report":
        return "report" in role or kind in {"json", "json_gzip"}
    if type_filter == "log":
        return "log" in role or kind in {"text", "text_gzip"}
    if type_filter == "index":
        return source == "archive_index"

    return True


def apply_filters(records, args):
    out = []

    needle = args.path.lower() if args.path else None

    for rec in records:
        if not matches_type(rec, args.type):
            continue

        if needle:
            hay = " ".join(str(rec.get(k, "")) for k in [
                "path",
                "source_path",
                "archive_path",
                "role",
                "kind",
            ]).lower()
            if needle not in hay:
                continue

        out.append(rec)

    return out



def path_is_under(path, roots):
    try:
        rp = Path(path).resolve()
    except Exception:
        return False

    for root in roots:
        try:
            rr = Path(root).resolve()
            rp.relative_to(rr)
            return True
        except Exception:
            pass

    return False


def choose_read_path(record, args):
    roots = [
        Path(args.state_dir),
        Path(args.log_dir),
        Path(args.archive_dir),
    ]

    candidates = []

    # Prefer archive payloads when the record points to both source and archive.
    for key in ["archive_path", "path", "source_path"]:
        value = record.get(key)
        if value:
            candidates.append(value)

    for value in candidates:
        path = Path(value)
        if path.exists() and path.is_file() and path_is_under(path, roots):
            return path

    return None


def read_text_preview(path, max_lines, max_line_chars):
    path = Path(path)
    gzip_mode = path.name.endswith(".gz")

    opener = gzip.open if gzip_mode else open
    lines = []
    truncated = False

    try:
        with opener(path, "rt", encoding="utf-8", errors="replace") as f:
            for idx, line in enumerate(f, start=1):
                if idx > max_lines:
                    truncated = True
                    break
                line = line.rstrip("\n")
                if len(line) > max_line_chars:
                    line = line[:max_line_chars] + "…"
                lines.append(line)
    except Exception as exc:
        return {
            "ok": False,
            "path": str(path),
            "gzip": gzip_mode,
            "error": str(exc),
            "lines": [],
            "truncated": False,
        }

    return {
        "ok": True,
        "path": str(path),
        "gzip": gzip_mode,
        "lines": lines,
        "line_count_shown": len(lines),
        "truncated": truncated,
    }


def build_show_results(records, args):
    show_results = []

    for record in records:
        path = choose_read_path(record, args)
        if not path:
            show_results.append({
                "ok": False,
                "record_path": record.get("path") or record.get("archive_path") or record.get("source_path"),
                "role": record.get("role"),
                "source": record.get("source"),
                "error": "no readable file under allowed LilHouse roots",
            })
            continue

        kind = record.get("kind", file_kind(path))
        if kind not in {"json", "jsonl", "text", "json_gzip", "jsonl_gzip", "text_gzip", "gzip"}:
            show_results.append({
                "ok": False,
                "path": str(path),
                "role": record.get("role"),
                "source": record.get("source"),
                "kind": kind,
                "error": "record kind is not treated as text-previewable",
            })
            continue

        result = read_text_preview(path, args.lines, args.max_line_chars)
        result.update({
            "role": record.get("role"),
            "source": record.get("source"),
            "kind": kind,
            "agent_access": record.get("agent_access"),
        })
        show_results.append(result)

    return show_results

def print_human(report):
    print()
    print("======================================")
    print(" LilHouse Storage Query")
    print("======================================")
    print()
    print("Mode: read-only")
    print(f"Type filter: {report['filters']['type']}")
    print(f"Path filter: {report['filters']['path'] or 'none'}")
    print(f"Results: {report['result_count']} shown of {report['total_matches']} matches")
    if report.get("show", {}).get("enabled"):
        print(f"Show: enabled, max lines per file: {report['show']['lines']}")
    print()

    if not report["records"]:
        print("No matching records.")
        print()
        print("Status: OK")
        return

    for rec in report["records"]:
        print(f"- {rec.get('role', 'unknown')} [{rec.get('source', 'unknown')}]")
        print(f"  path:   {rec.get('path') or rec.get('archive_path') or rec.get('source_path')}")
        print(f"  kind:   {rec.get('kind', 'unknown')}")
        print(f"  size:   {rec.get('human') or human_bytes(rec.get('bytes') or 0)}")
        if rec.get("line_count") is not None:
            print(f"  lines:  {rec.get('line_count')}")
        if rec.get("agent_access"):
            print(f"  access: {rec.get('agent_access')}")
        if rec.get("verified_payload_sha256_match") is not None:
            print(f"  verified_payload: {rec.get('verified_payload_sha256_match')}")
        if rec.get("deleted_source") is not None:
            print(f"  deleted_source:   {rec.get('deleted_source')}")

    if report.get("show", {}).get("enabled"):
        print()
        print("======================================")
        print(" Preview")
        print("======================================")

        for item in report.get("show_results", []):
            print()
            label = item.get("path") or item.get("record_path") or "unknown"
            print(f"--- {label} [{item.get('role', 'unknown')}/{item.get('source', 'unknown')}] ---")

            if not item.get("ok"):
                print(f"ERROR: {item.get('error', 'unavailable')}")
                continue

            for idx, line in enumerate(item.get("lines", []), start=1):
                print(f"{idx:04d}: {line}")

            if item.get("truncated"):
                print("... truncated by --lines limit ...")

    print()
    print("Status: OK")

def main():
    ap = argparse.ArgumentParser(description="Read-only query over LilHouse hot storage and archive indexes.")
    ap.add_argument("--list", action="store_true", help="List matching records. This is the default.")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--type", default="all", choices=["all", "hot", "ledger", "archive", "report", "log", "index"])
    ap.add_argument("--path", default="")
    ap.add_argument("--limit", type=int, default=50)
    ap.add_argument("--show", action="store_true", help="Preview matching text/gzip records read-only. Requires --path.")
    ap.add_argument("--lines", type=int, default=80, help="Maximum preview lines per matching record when --show is used.")
    ap.add_argument("--max-line-chars", type=int, default=2000, help="Maximum characters per preview line.")
    ap.add_argument("--state-dir", default=DEFAULT_STATE_DIR)
    ap.add_argument("--log-dir", default=DEFAULT_LOG_DIR)
    ap.add_argument("--archive-dir", default=DEFAULT_ARCHIVE_DIR)
    args = ap.parse_args()

    all_records = collect_records(args)
    matches = apply_filters(all_records, args)
    shown = matches[: max(0, args.limit)]

    show_results = []
    if args.show:
        if not args.path:
            print("ERROR: --show requires --path to avoid dumping too much history.")
            print("Try: sudo lilhouse-storage-query --path events --show --lines 40")
            return 2
        show_results = build_show_results(shown, args)

    report = {
        "schema": "lilhouse.storage_query.v1",
        "ok": True,
        "ts": now_iso(),
        "mode": "read_only",
        "writes_files": False,
        "deletes_files": False,
        "state_dir": str(Path(args.state_dir)),
        "log_dir": str(Path(args.log_dir)),
        "archive_dir": str(Path(args.archive_dir)),
        "filters": {
            "type": args.type,
            "path": args.path,
            "limit": args.limit,
        },
        "total_records_seen": len(all_records),
        "total_matches": len(matches),
        "result_count": len(shown),
        "records": shown,
        "show": {
            "enabled": bool(args.show),
            "lines": args.lines,
            "max_line_chars": args.max_line_chars,
            "requires_path_filter": True,
        },
        "show_results": show_results,
    }

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_human(report)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
