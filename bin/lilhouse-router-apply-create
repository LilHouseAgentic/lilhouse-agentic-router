#!/usr/bin/env python3
import argparse
import json
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Apply staged LilHouse router files into a non-live target root. Refuses live /."
    )
    parser.add_argument("apply_dry_run", help="router apply dry-run JSON.")
    parser.add_argument("--target-root", required=True, help="Target root to copy staged files into.")
    parser.add_argument("--yes", action="store_true", help="Required confirmation flag.")
    args = parser.parse_args()

    dry_run_path = Path(args.apply_dry_run).resolve()
    target_root = Path(args.target_root).resolve()

    if not args.yes:
        print("ERROR: refusing to copy files without --yes", file=sys.stderr)
        return 2

    if str(target_root) == "/":
        print("ERROR: refusing to apply into live /", file=sys.stderr)
        return 2

    if not dry_run_path.is_file():
        print(f"ERROR: apply dry-run report not found: {dry_run_path}", file=sys.stderr)
        return 1

    dry_run = json.loads(dry_run_path.read_text(encoding="utf-8"))
    errors = []

    if dry_run.get("schema") != "lilhouse.router_apply_dry_run.v1":
        errors.append("input is not an apply dry-run report")
    if dry_run.get("ok") is not True:
        errors.append("apply dry-run is not OK")
    if dry_run.get("apply") is not False:
        errors.append("apply dry-run must be non-applying")
    if dry_run.get("copies_files") is not False:
        errors.append("apply dry-run must declare copies_files false")

    copied = []

    if not errors:
        target_root.mkdir(parents=True, exist_ok=True)

        for item in dry_run.get("would_copy", []):
            if item.get("would_copy") is not True:
                continue

            source = Path(item["source"]).resolve()
            rel = item["relative_path"]
            target = target_root / rel

            if not source.is_file():
                errors.append(f"source file missing: {source}")
                continue

            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)

            copied.append(
                {
                    "relative_path": rel,
                    "source": str(source),
                    "target": str(target),
                    "copied": target.is_file(),
                }
            )

    result = {
        "schema": "lilhouse.router_apply_create.v1",
        "mode": "apply-create",
        "apply": True,
        "live_changes": False,
        "live_root_allowed": False,
        "generated": datetime.now(timezone.utc).isoformat(),
        "apply_dry_run": str(dry_run_path),
        "target_root": str(target_root),
        "ok": not errors,
        "error_count": len(errors),
        "errors": errors,
        "copied_count": sum(1 for item in copied if item["copied"]),
        "copied": copied,
        "summary": {
            "copied_count": sum(1 for item in copied if item["copied"]),
            "expected_copy_count": dry_run.get("would_copy_count"),
            "safe_to_apply_live": False,
        },
    }

    report_path = target_root / "apply-create-report.json"
    report_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
