#!/usr/bin/env python3
import argparse
import hashlib
import json
import os
import sys
from pathlib import Path
from datetime import datetime, timezone

DEFAULT_STATE_DIR = os.environ.get("LILHOUSE_STATE_DIR", "/var/lib/lilhouse")
DEFAULT_ARCHIVE_DIR = os.environ.get("LILHOUSE_ARCHIVE_DIR", "/var/lib/lilhouse/archive")

ACTIVE_LEDGERS = [
    "events.jsonl",
    "actions.jsonl",
    "proposals.jsonl",
]


def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat()


def human_bytes(num):
    try:
        num = float(num)
    except Exception:
        return "unknown"

    units = ["B", "KB", "MB", "GB", "TB"]
    for unit in units:
        if abs(num) < 1024.0:
            if unit == "B":
                return f"{int(num)} {unit}"
            return f"{num:.1f} {unit}"
        num /= 1024.0
    return f"{num:.1f} PB"


def safe_stat(path):
    try:
        st = path.stat()
        return {
            "exists": True,
            "bytes": st.st_size,
            "mtime": datetime.fromtimestamp(st.st_mtime, timezone.utc).astimezone().isoformat(),
        }
    except Exception as exc:
        return {
            "exists": False,
            "bytes": 0,
            "mtime": None,
            "error": str(exc),
        }


def sha256_file(path):
    h = hashlib.sha256()
    with Path(path).open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def count_lines(path):
    p = Path(path)
    if not p.exists() or not p.is_file():
        return 0
    with p.open("r", encoding="utf-8", errors="replace") as f:
        return sum(1 for _ in f)


def archive_target_for(path, archive_dir, source_sha):
    date = datetime.now(timezone.utc).strftime("%Y%m%d")
    name = Path(path).name
    return Path(archive_dir) / "ledgers" / f"{name}.{date}.{source_sha[:12]}.jsonl.gz"


def build_plan(args):
    state_dir = Path(args.state_dir)
    archive_dir = Path(args.archive_dir)

    candidates = []
    preserve = []

    for name in ACTIVE_LEDGERS:
        p = state_dir / name
        info = safe_stat(p)

        if not info["exists"]:
            preserve.append({
                "ledger": name,
                "path": str(p),
                "reason": "ledger not present yet",
            })
            continue

        lines = count_lines(p)
        if info["bytes"] == 0 or lines == 0:
            preserve.append({
                "ledger": name,
                "path": str(p),
                "bytes": info["bytes"],
                "line_count": lines,
                "reason": "empty active ledger does not need checkpoint",
            })
            continue

        source_sha = sha256_file(p)
        exceeds_bytes = info["bytes"] > args.max_hot_bytes
        exceeds_lines = lines > args.max_hot_lines

        if exceeds_bytes or exceeds_lines or args.include_small:
            archive_target = archive_target_for(p, archive_dir, source_sha)
            candidates.append({
                "ledger": name,
                "source_path": str(p),
                "source_bytes": info["bytes"],
                "source_human": human_bytes(info["bytes"]),
                "source_mtime": info["mtime"],
                "source_sha256": source_sha,
                "line_count": lines,
                "archive_path": str(archive_target),
                "index_file": str(archive_dir / "index.jsonl"),
                "reason": {
                    "exceeds_bytes": exceeds_bytes,
                    "exceeds_lines": exceeds_lines,
                    "include_small": bool(args.include_small),
                    "max_hot_bytes": args.max_hot_bytes,
                    "max_hot_lines": args.max_hot_lines,
                },
                "future_required_order": [
                    "copy active ledger to compressed archive",
                    "verify decompressed archive payload SHA256 equals source SHA256",
                    "append archive action record to archive index",
                    "write checkpoint marker with source SHA256 and line count",
                    "only then may a future release truncate/checkpoint the live ledger",
                ],
                "executes_now": False,
                "writes_archive_now": False,
                "writes_index_now": False,
                "truncates_ledger_now": False,
                "deletes_source_now": False,
            })
        else:
            preserve.append({
                "ledger": name,
                "path": str(p),
                "bytes": info["bytes"],
                "line_count": lines,
                "reason": "active ledger below checkpoint thresholds",
            })

    candidate_bytes = sum(c["source_bytes"] for c in candidates)
    candidate_lines = sum(c["line_count"] for c in candidates)

    return {
        "schema": "lilhouse.ledger_checkpoint_plan.v1",
        "ok": True,
        "ts": now_iso(),
        "mode": "dry_run_only",
        "executes_changes": False,
        "writes_archives": False,
        "writes_index": False,
        "truncates_ledgers": False,
        "deletes_sources": False,
        "state_dir": str(state_dir),
        "archive_dir": str(archive_dir),
        "policy": {
            "lossless_by_default": True,
            "active_ledgers_preserved": True,
            "checkpoint_execution_not_available_in_this_release": True,
            "archive_and_index_must_exist_before_future_truncation": True,
        },
        "candidates": candidates,
        "preserve": preserve,
        "summary": {
            "candidate_count": len(candidates),
            "candidate_bytes": candidate_bytes,
            "candidate_human": human_bytes(candidate_bytes),
            "candidate_lines": candidate_lines,
            "deleted_count": 0,
            "truncated_count": 0,
        },
    }


def print_human(plan):
    print()
    print("======================================")
    print(" LilHouse Ledger Checkpoint Dry Run")
    print("======================================")
    print()
    print("Safety:")
    print("  mode: dry-run only")
    print("  writes archives: no")
    print("  writes index: no")
    print("  truncates ledgers: no")
    print("  deletes sources: no")
    print()

    print("Candidates:")
    if plan["candidates"]:
        for c in plan["candidates"]:
            print(f"  - {c['ledger']}")
            print(f"    source: {c['source_path']}")
            print(f"    lines:  {c['line_count']}")
            print(f"    size:   {c['source_human']}")
            print(f"    sha256: {c['source_sha256']}")
            print(f"    target: {c['archive_path']}")
            print("    future order:")
            for step in c["future_required_order"]:
                print(f"      - {step}")
    else:
        print("  none")

    print()
    print("Preserved:")
    for item in plan["preserve"]:
        print(f"  - {item['ledger']}: {item['reason']}")

    print()
    print(f"Candidate bytes: {plan['summary']['candidate_human']}")
    print(f"Candidate lines: {plan['summary']['candidate_lines']}")
    print("Status: OK")


def main():
    ap = argparse.ArgumentParser(description="Plan future lossless checkpoints for active LilHouse JSONL ledgers.")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--execute", action="store_true", help="Not available in this alpha; always refused.")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--state-dir", default=DEFAULT_STATE_DIR)
    ap.add_argument("--archive-dir", default=DEFAULT_ARCHIVE_DIR)
    ap.add_argument("--max-hot-bytes", type=int, default=5 * 1024 * 1024)
    ap.add_argument("--max-hot-lines", type=int, default=10000)
    ap.add_argument("--include-small", action="store_true", help="Include non-empty ledgers even below thresholds.")
    args = ap.parse_args()

    if args.execute:
        print("ERROR: ledger checkpoint execution is not available in this alpha.", file=sys.stderr)
        print("Use: sudo lilhouse-storage-ledger-checkpoint --dry-run", file=sys.stderr)
        return 2

    if not args.dry_run:
        print("ERROR: this command currently only supports --dry-run.", file=sys.stderr)
        print("Try: sudo lilhouse-storage-ledger-checkpoint --dry-run", file=sys.stderr)
        return 2

    plan = build_plan(args)

    if args.json:
        print(json.dumps(plan, indent=2, sort_keys=True))
    else:
        print_human(plan)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
