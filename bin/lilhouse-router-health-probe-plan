#!/usr/bin/env python3
import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Plan future live post-apply health probes. Writes nothing and runs no probes."
    )
    parser.add_argument("health_rehearsal_report")
    parser.add_argument("--lan-ip", default="10.23.0.1")
    parser.add_argument("--dns-test-name", default="example.com")
    parser.add_argument("--wan-test-ip", default="1.1.1.1")
    parser.add_argument("--timeout-seconds", type=int, default=120)
    args = parser.parse_args()

    report_path = Path(args.health_rehearsal_report).resolve()
    if not report_path.is_file():
        print(f"ERROR: health rehearsal report not found: {report_path}", file=sys.stderr)
        return 1

    rehearsal = json.loads(report_path.read_text(encoding="utf-8"))
    errors = []

    if rehearsal.get("schema") != "lilhouse.router_post_apply_health_rehearsal.v1":
        errors.append("input is not a post-apply health rehearsal report")
    if rehearsal.get("ok") is not True:
        errors.append("health rehearsal is not OK")
    if rehearsal.get("apply") is not False:
        errors.append("health rehearsal must be non-applying")
    if rehearsal.get("live_changes") is not False:
        errors.append("health rehearsal must declare live_changes false")
    if rehearsal.get("summary", {}).get("failure_blocks_rollback_cancel") is not True:
        errors.append("health rehearsal must prove failure blocks rollback cancellation")

    if args.timeout_seconds < 30 or args.timeout_seconds > 900:
        errors.append("timeout-seconds must be between 30 and 900")

    probes = [
        {
            "order": 10,
            "id": "local_admin_path",
            "future_command": "manual/local-console-confirmation",
            "target": "local console or out-of-band access",
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "order": 20,
            "id": "lan_gateway_reachable",
            "future_command": f"ping -c 3 -W 2 {args.lan_ip}",
            "target": args.lan_ip,
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "order": 30,
            "id": "dns_resolution",
            "future_command": f"getent ahosts {args.dns_test_name}",
            "target": args.dns_test_name,
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "order": 40,
            "id": "wan_reachability",
            "future_command": f"ping -c 3 -W 2 {args.wan_test_ip}",
            "target": args.wan_test_ip,
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "order": 50,
            "id": "dhcp_service_state",
            "future_command": "systemctl is-active pihole-FTL",
            "target": "DHCP/DNS provider",
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "order": 60,
            "id": "firewall_service_state",
            "future_command": "systemctl is-active nftables",
            "target": "nftables",
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "order": 70,
            "id": "rollback_timer_state",
            "future_command": "systemctl is-active lilhouse-router-rollback-guard.timer",
            "target": "rollback guard timer",
            "required": True,
            "failure_action": "do not cancel rollback",
        },
    ]

    result = {
        "schema": "lilhouse.router_health_probe_plan.v1",
        "mode": "health-probe-plan",
        "apply": False,
        "live_changes": False,
        "runs_probes": False,
        "generated": datetime.now(timezone.utc).isoformat(),
        "ok": not errors,
        "error_count": len(errors),
        "errors": errors,
        "health_rehearsal_report": str(report_path),
        "timeout_seconds": args.timeout_seconds,
        "probes": probes,
        "summary": {
            "probe_count": len(probes),
            "required_probe_count": sum(1 for p in probes if p["required"]),
            "requires_all_probes_pass": True,
            "rollback_cancel_allowed_only_after_pass": True,
            "safe_to_cancel_rollback_now": False,
            "safe_to_apply_live": False,
        },
    }

    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
