#!/usr/bin/env bash
set -euo pipefail

COMMON="${LILHOUSE_COMMON:-/usr/lib/lilhouse/lilhouse-common.sh}"
if [ -f "$COMMON" ]; then
  # shellcheck source=/dev/null
  . "$COMMON"
else
  : "${LILHOUSE_STATE_DIR:=/var/lib/lilhouse}"
  : "${LILHOUSE_RUNTIME_DIR:=/run/lilhouse}"
  : "${LILHOUSE_LOG_DIR:=/var/log/lilhouse}"
  lilhouse_ensure_dirs() { mkdir -p "$LILHOUSE_STATE_DIR" "$LILHOUSE_RUNTIME_DIR" "$LILHOUSE_LOG_DIR"; }
fi

lilhouse_ensure_dirs

OUT="${LILHOUSE_STORAGE_HEALTH_FILE:-$LILHOUSE_STATE_DIR/storage-health.json}"
PATHS="${LILHOUSE_STORAGE_PATHS:-/,/var/lib/lilhouse}"
WARN_PERCENT="${LILHOUSE_STORAGE_WARN_PERCENT:-85}"
CRIT_PERCENT="${LILHOUSE_STORAGE_CRIT_PERCENT:-95}"

python3 - "$OUT" "$PATHS" "$WARN_PERCENT" "$CRIT_PERCENT" <<'PY'
import json
import os
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path

out, paths_raw, warn_raw, crit_raw = sys.argv[1:5]
warn = float(warn_raw)
crit = float(crit_raw)

paths = []
for item in paths_raw.split(","):
    item = item.strip()
    if item and item not in paths:
        paths.append(item)

results = []
overall = "ok"

for path in paths:
    p = Path(path)
    entry = {
        "path": path,
        "exists": p.exists(),
        "is_mount": p.is_mount(),
    }

    if not p.exists():
        entry["status"] = "missing"
        overall = "warning" if overall == "ok" else overall
        results.append(entry)
        continue

    try:
        usage = shutil.disk_usage(path)
        used_percent = round((usage.used / usage.total) * 100, 2) if usage.total else None
        entry.update({
            "total_bytes": usage.total,
            "used_bytes": usage.used,
            "free_bytes": usage.free,
            "used_percent": used_percent,
        })

        if used_percent is not None and used_percent >= crit:
            entry["status"] = "critical"
            overall = "critical"
        elif used_percent is not None and used_percent >= warn:
            entry["status"] = "warning"
            if overall != "critical":
                overall = "warning"
        else:
            entry["status"] = "ok"
    except Exception as exc:
        entry["status"] = "error"
        entry["error"] = str(exc)
        if overall != "critical":
            overall = "warning"

    results.append(entry)

report = {
    "ts": datetime.now(timezone.utc).astimezone().isoformat(),
    "overall": overall,
    "warn_percent": warn,
    "critical_percent": crit,
    "paths": results,
}

Path(out).parent.mkdir(parents=True, exist_ok=True)
Path(out).write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
print(out)
PY
