#!/usr/bin/env python3
import argparse
import json
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Stage a LilHouse router preview package into a target root. Refuses live /."
    )
    parser.add_argument("preview_dir", help="Preview directory generated by lilhouse-router-wizard.")
    parser.add_argument("--target-root", required=True, help="Target root to stage files into.")
    parser.add_argument("--yes", action="store_true", help="Required confirmation flag.")
    args = parser.parse_args()

    preview_dir = Path(args.preview_dir).resolve()
    target_root = Path(args.target_root).resolve()

    if not args.yes:
        print("ERROR: refusing to stage files without --yes", file=sys.stderr)
        return 2

    if str(target_root) == "/":
        print("ERROR: refusing to stage preview into live /", file=sys.stderr)
        return 2

    if not preview_dir.is_dir():
        print(f"ERROR: preview directory not found: {preview_dir}", file=sys.stderr)
        return 1

    validator = Path(__file__).resolve().with_name("lilhouse-router-preview-validate")
    if not validator.exists():
        print(f"ERROR: preview validator not found: {validator}", file=sys.stderr)
        return 1

    subprocess.check_call([str(validator), str(preview_dir)], stdout=subprocess.DEVNULL)

    staged = []
    for source in sorted(preview_dir.rglob("*")):
        if not source.is_file():
            continue

        rel = source.relative_to(preview_dir)
        target = target_root / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, target)

        staged.append(
            {
                "source": str(source),
                "relative_path": str(rel),
                "target": str(target),
            }
        )

    report = {
        "schema": "lilhouse.router_stage_preview.v1",
        "mode": "stage-preview",
        "apply": True,
        "live_root_allowed": False,
        "preview_dir": str(preview_dir),
        "target_root": str(target_root),
        "generated": datetime.now(timezone.utc).isoformat(),
        "staged_count": len(staged),
        "staged": staged,
    }

    report_path = target_root / "stage-preview-report.json"
    report_path.parent.mkdir(parents=True, exist_ok=True)
    report_path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print(json.dumps(report, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
