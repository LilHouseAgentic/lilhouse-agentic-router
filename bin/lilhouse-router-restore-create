#!/usr/bin/env python3
import argparse
import hashlib
import json
import shutil
import sys
from datetime import datetime, timezone
from pathlib import Path


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def rooted(root: Path, absolute_path: str) -> Path:
    return root / absolute_path.lstrip("/")


def restore_path(source: Path, target: Path) -> str:
    target.parent.mkdir(parents=True, exist_ok=True)

    if source.is_file():
        shutil.copy2(source, target)
        return "file_restored"

    if source.is_dir():
        if target.exists():
            shutil.rmtree(target)
        shutil.copytree(source, target, symlinks=True)
        return "directory_restored"

    return "skipped"


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Restore a LilHouse router backup into a root filesystem."
    )
    parser.add_argument("backup_dir", help="Backup directory containing backup-report.json.")
    parser.add_argument("--root", required=True, help="Root filesystem restore target.")
    parser.add_argument(
        "--yes",
        action="store_true",
        help="Required confirmation flag. Without this, no files are restored.",
    )
    parser.add_argument(
        "--allow-live-root",
        action="store_true",
        help="Explicitly allow restoring into live /. Dangerous; future live executor only.",
    )
    args = parser.parse_args()

    backup_dir = Path(args.backup_dir).resolve()
    root = Path(args.root).resolve()
    report_path = backup_dir / "backup-report.json"

    if root == Path("/") and not args.allow_live_root:
        print("ERROR: refusing to restore into live / without --allow-live-root", file=sys.stderr)
        return 2

    if not args.yes:
        print("ERROR: refusing to restore files without --yes", file=sys.stderr)
        return 2

    if not report_path.is_file():
        print(f"ERROR: backup report not found: {report_path}", file=sys.stderr)
        return 1

    root.mkdir(parents=True, exist_ok=True)
    backup_report = json.loads(report_path.read_text(encoding="utf-8"))

    entries = []
    errors = []

    for entry in backup_report.get("entries", []):
        action = entry.get("action")
        source_path = entry.get("path")
        backup_target = Path(entry.get("backup_target", ""))
        restore_target = rooted(root, source_path)

        if action == "missing":
            entries.append(
                {
                    "path": source_path,
                    "backup_action": action,
                    "restore_action": "skipped_missing_source",
                    "backup_target": str(backup_target),
                    "restore_target": str(restore_target),
                    "restored": False,
                    "verified": True,
                }
            )
            continue

        if action not in ("file_copied", "directory_copied"):
            errors.append(f"unknown backup action for {source_path}: {action}")
            continue

        if not backup_target.exists():
            errors.append(f"backup target missing for {source_path}: {backup_target}")
            continue

        restore_action = restore_path(backup_target, restore_target)

        verified = False
        if backup_target.is_file() and restore_target.is_file():
            verified = sha256_file(backup_target) == sha256_file(restore_target)
        elif backup_target.is_dir() and restore_target.is_dir():
            verified = True

        if not verified:
            errors.append(f"restore verification failed for {source_path}")

        entries.append(
            {
                "path": source_path,
                "backup_action": action,
                "restore_action": restore_action,
                "backup_target": str(backup_target),
                "restore_target": str(restore_target),
                "restored": restore_action in ("file_restored", "directory_restored"),
                "verified": verified,
            }
        )

    result = {
        "schema": "lilhouse.router_restore_create.v1",
        "mode": "restore-create",
        "apply": True,
        "backup_dir": str(backup_dir),
        "root": str(root),
        "generated": datetime.now(timezone.utc).isoformat(),
        "ok": not errors,
        "entries": entries,
        "errors": errors,
        "summary": {
            "total": len(entries),
            "restored": sum(1 for e in entries if e["restored"]),
            "skipped_missing_sources": sum(1 for e in entries if e["restore_action"] == "skipped_missing_source"),
            "errors": len(errors),
        },
    }

    restore_report = root / "restore-report.json"
    restore_report.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if not errors else 1


if __name__ == "__main__":
    raise SystemExit(main())
