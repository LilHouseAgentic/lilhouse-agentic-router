#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

WAN=""
LAN=""
LAN_CIDR="10.23.0.1/24"
LAN_IP="10.23.0.1"
DHCP_START="10.23.0.100"
DHCP_END="10.23.0.200"
PREPARE_ONLY=0
YES=0

usage() {
  cat <<USAGE
Usage:
  sudo bin/lilhouse-router-appliance-install --wan IFACE --lan IFACE [options]

Options:
  --wan IFACE          Internet/WAN interface
  --lan IFACE          Home/LAN interface
  --lan-cidr CIDR      LAN gateway CIDR, default 10.23.0.1/24
  --dhcp-start IP      DHCP start, default 10.23.0.100
  --dhcp-end IP        DHCP end, default 10.23.0.200
  --prepare-only       Install/configure prerequisites and services, do not run final deploy chain
  --yes                Required for non-interactive install
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --wan) WAN="${2:?missing --wan value}"; shift 2 ;;
    --lan) LAN="${2:?missing --lan value}"; shift 2 ;;
    --lan-cidr) LAN_CIDR="${2:?missing --lan-cidr value}"; shift 2 ;;
    --dhcp-start) DHCP_START="${2:?missing --dhcp-start value}"; shift 2 ;;
    --dhcp-end) DHCP_END="${2:?missing --dhcp-end value}"; shift 2 ;;
    --prepare-only) PREPARE_ONLY=1; shift ;;
    --yes) YES=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

LAN_IP="${LAN_CIDR%/*}"

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: appliance install must run as root." >&2
    exit 2
  fi
}

need_yes() {
  if [ "$YES" -ne 1 ]; then
    echo "ERROR: refusing appliance install without --yes" >&2
    exit 2
  fi
}

need_iface() {
  iface="$1"
  label="$2"
  if [ -z "$iface" ]; then
    echo "ERROR: missing $label interface." >&2
    exit 2
  fi
  if ! ip link show dev "$iface" >/dev/null 2>&1; then
    echo "ERROR: $label interface not found: $iface" >&2
    exit 2
  fi
}

need_debian_systemd() {
  if ! command -v apt-get >/dev/null 2>&1; then
    echo "ERROR: this appliance installer currently requires Debian/apt." >&2
    exit 2
  fi
  if ! command -v systemctl >/dev/null 2>&1; then
    echo "ERROR: this appliance installer requires systemd." >&2
    exit 2
  fi
}

apt_install_base() {
  echo
  echo "=== Installing appliance packages ==="

  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y \
    ca-certificates \
    curl \
    dnsutils \
    iproute2 \
    nftables \
    procps \
    python3 \
    systemd \
    unbound
}

install_lilhouse_core() {
  echo
  echo "=== Installing LilHouse core ==="

  "$REPO_DIR/install.sh" \
    --mode observe-only \
    --no-systemd
}

configure_lan_networkd() {
  echo
  echo "=== Configuring LAN interface with systemd-networkd ==="

  mkdir -p /etc/systemd/network

  cat >"/etc/systemd/network/20-lilhouse-lan.network" <<NETEOF
# Generated by LilHouse Agentic Router appliance installer
[Match]
Name=$LAN

[Network]
Address=$LAN_CIDR
IPForward=yes
ConfigureWithoutCarrier=yes
LinkLocalAddressing=yes
NETEOF

  systemctl enable systemd-networkd
  systemctl restart systemd-networkd || true

  ip addr replace "$LAN_CIDR" dev "$LAN" || true
  ip link set "$LAN" up || true
}

configure_unbound() {
  echo
  echo "=== Configuring Unbound recursive DNS ==="

  mkdir -p /etc/unbound/unbound.conf.d

  cat > /etc/unbound/unbound.conf.d/lilhouse.conf <<'UNBOUNDEOF'
# Generated by LilHouse Agentic Router appliance installer
server:
  interface: 127.0.0.1
  port: 5335

  access-control: 127.0.0.0/8 allow
  access-control: ::1 allow

  do-ip4: yes
  do-ip6: yes
  do-udp: yes
  do-tcp: yes

  qname-minimisation: yes
  edns-buffer-size: 1232
  harden-glue: yes
  harden-dnssec-stripped: yes
  prefetch: yes

  hide-identity: yes
  hide-version: yes
UNBOUNDEOF

  systemctl enable unbound
  systemctl restart unbound
}

install_pihole_if_missing() {
  if command -v pihole-FTL >/dev/null 2>&1 && systemctl list-unit-files pihole-FTL.service --no-legend >/dev/null 2>&1; then
    echo
    echo "=== Pi-hole already installed ==="
    return 0
  fi

  echo
  echo "=== Installing Pi-hole ==="

  mkdir -p /etc/pihole

  cat > /etc/pihole/setupVars.conf <<VARSEOF
PIHOLE_INTERFACE=$LAN
IPV4_ADDRESS=$LAN_IP
IPV6_ADDRESS=
PIHOLE_DNS_1=127.0.0.1#5335
QUERY_LOGGING=true
INSTALL_WEB_SERVER=true
INSTALL_WEB_INTERFACE=true
LIGHTTPD_ENABLED=true
BLOCKING_ENABLED=true
DNSMASQ_LISTENING=single
VARSEOF

  installer="/tmp/lilhouse-pihole-basic-install.sh"
  curl -fsSL https://install.pi-hole.net -o "$installer"
  chmod +x "$installer"

  PIHOLE_SKIP_OS_CHECK=true bash "$installer" --unattended
}

configure_pihole() {
  echo
  echo "=== Configuring Pi-hole DNS/DHCP ==="

  if ! command -v pihole-FTL >/dev/null 2>&1; then
    echo "ERROR: pihole-FTL missing after install." >&2
    exit 2
  fi

  mkdir -p /etc/dnsmasq.d

  cat > /etc/dnsmasq.d/02-lilhouse-dhcp.conf <<DNSMASQEOF
# Generated by LilHouse Agentic Router appliance installer
interface=$LAN
bind-interfaces
dhcp-authoritative
dhcp-range=$DHCP_START,$DHCP_END,24h
dhcp-option=option:router,$LAN_IP
dhcp-option=option:dns-server,$LAN_IP
DNSMASQEOF

  # Pi-hole v6/FTL preferred config path. If this fails, the installer must fail.
  pihole-FTL --config dns.upstreams '[ "127.0.0.1#5335" ]'

  systemctl enable pihole-FTL
  systemctl restart pihole-FTL
}

verify_required_services() {
  echo
  echo "=== Verifying required appliance services ==="

  failed=0

  for svc in systemd-networkd nftables unbound pihole-FTL lilhouse-current-state.timer lilhouse-storage-health.timer; do
    if systemctl is-active --quiet "$svc"; then
      echo "OK: $svc"
    else
      echo "FAIL: $svc"
      failed=1
    fi
  done

  if [ "$failed" -ne 0 ]; then
    echo "ERROR: one or more required appliance services are not active." >&2
    exit 2
  fi
}

main() {
  need_root
  need_yes
  need_debian_systemd
  need_iface "$WAN" "WAN"
  need_iface "$LAN" "LAN"

  if [ "$WAN" = "$LAN" ]; then
    echo "ERROR: WAN and LAN must be different interfaces." >&2
    exit 2
  fi

  echo
  echo "LilHouse Agentic Router appliance install"
  echo "wan=$WAN"
  echo "lan=$LAN"
  echo "lan_cidr=$LAN_CIDR"
  echo "dhcp_start=$DHCP_START"
  echo "dhcp_end=$DHCP_END"

  apt_install_base
  install_lilhouse_core
  configure_lan_networkd
  configure_unbound
  install_pihole_if_missing
  configure_pihole

  systemctl daemon-reload
  echo
echo "=== Preparing base nftables ruleset ==="
cat > /etc/nftables.conf <<'NFT'
#!/usr/sbin/nft -f

flush ruleset
NFT
nft -f /etc/nftables.conf
systemctl enable --now nftables
  systemctl enable --now lilhouse-current-state.timer
  systemctl enable --now lilhouse-storage-health.timer

  verify_required_services

  echo
  echo "LilHouse appliance preparation complete."

  if [ "$PREPARE_ONLY" -eq 1 ]; then
    exit 0
  fi

  echo "Full final deploy chain is handled by easy-install/live orchestrator for now."
}

main "$@"
