#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

WAN=""
LAN=""
LAN_CIDR="10.23.0.1/24"
LAN_IP="10.23.0.1"
DHCP_START="10.23.0.100"
DHCP_END="10.23.0.200"
CAKE_DOWN="100mbit"
CAKE_UP="20mbit"
CAKE_IFB="ifb0"
PREPARE_ONLY=0
YES=0

usage() {
  cat <<USAGE
Usage:
  sudo bin/lilhouse-router-appliance-install --wan IFACE --lan IFACE [options]

Options:
  --wan IFACE          Internet/WAN interface
  --lan IFACE          Home/LAN interface
  --lan-cidr CIDR      LAN gateway CIDR, default 10.23.0.1/24
  --dhcp-start IP      DHCP start, default 10.23.0.100
  --dhcp-end IP        DHCP end, default 10.23.0.200
  --cake-down RATE     CAKE download/ingress rate, default 100mbit
  --cake-up RATE       CAKE upload/egress rate, default 20mbit
  --prepare-only       Install/configure prerequisites and services, do not run final deploy chain
  --yes                Required for non-interactive install
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --wan) WAN="${2:?missing --wan value}"; shift 2 ;;
    --lan) LAN="${2:?missing --lan value}"; shift 2 ;;
    --lan-cidr) LAN_CIDR="${2:?missing --lan-cidr value}"; shift 2 ;;
    --dhcp-start) DHCP_START="${2:?missing --dhcp-start value}"; shift 2 ;;
    --dhcp-end) DHCP_END="${2:?missing --dhcp-end value}"; shift 2 ;;
    --cake-down) CAKE_DOWN="${2:?missing --cake-down value}"; shift 2 ;;
    --cake-up) CAKE_UP="${2:?missing --cake-up value}"; shift 2 ;;
    --prepare-only) PREPARE_ONLY=1; shift ;;
    --yes) YES=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "ERROR: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

LAN_IP="${LAN_CIDR%/*}"
LAN_NET="$(python3 -c 'import ipaddress,sys; print(ipaddress.ip_interface(sys.argv[1]).network)' "$LAN_CIDR")"

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: appliance install must run as root." >&2
    exit 2
  fi
}

need_yes() {
  if [ "$YES" -ne 1 ]; then
    echo "ERROR: refusing appliance install without --yes" >&2
    exit 2
  fi
}

need_iface() {
  iface="$1"
  label="$2"
  if [ -z "$iface" ]; then
    echo "ERROR: missing $label interface." >&2
    exit 2
  fi
  if ! ip link show dev "$iface" >/dev/null 2>&1; then
    echo "ERROR: $label interface not found: $iface" >&2
    exit 2
  fi
}

need_debian_systemd() {
  if ! command -v apt-get >/dev/null 2>&1; then
    echo "ERROR: this appliance installer currently requires Debian/apt." >&2
    exit 2
  fi
  if ! command -v systemctl >/dev/null 2>&1; then
    echo "ERROR: this appliance installer requires systemd." >&2
    exit 2
  fi
}

apt_install_base() {
  echo
  echo "=== Installing appliance packages ==="

  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y \
    ca-certificates \
    curl \
    dnsutils \
    iproute2 \
    kmod \
    nftables \
    procps \
    python3 \
    systemd \
    unbound
}

install_lilhouse_core() {
  echo
  echo "=== Installing LilHouse core ==="

  "$REPO_DIR/install.sh" \
    --mode observe-only \
    --no-systemd
}

configure_lan_networkd() {
  echo
  echo "=== Configuring LAN interface with systemd-networkd ==="

  mkdir -p /etc/systemd/network

  cat >"/etc/systemd/network/20-lilhouse-lan.network" <<NETEOF
# Generated by LilHouse Agentic Router appliance installer
[Match]
Name=$LAN

[Network]
Address=$LAN_CIDR
IPv4Forwarding=yes
IPv6Forwarding=yes
ConfigureWithoutCarrier=yes
LinkLocalAddressing=yes
NETEOF

  systemctl enable systemd-networkd
  systemctl restart systemd-networkd || true

  ip addr replace "$LAN_CIDR" dev "$LAN" || true
  ip link set "$LAN" up || true
}

configure_unbound() {
  echo
  echo "=== Configuring Unbound recursive DNS ==="

  mkdir -p /etc/unbound/unbound.conf.d

  cat > /etc/unbound/unbound.conf.d/lilhouse.conf <<'UNBOUNDEOF'
# Generated by LilHouse Agentic Router appliance installer
server:
  interface: 127.0.0.1
  port: 5335

  access-control: 127.0.0.0/8 allow
  access-control: ::1 allow

  do-ip4: yes
  do-ip6: yes
  do-udp: yes
  do-tcp: yes

  qname-minimisation: yes
  edns-buffer-size: 1232
  harden-glue: yes
  harden-dnssec-stripped: yes
  prefetch: yes

  hide-identity: yes
  hide-version: yes
UNBOUNDEOF

  systemctl enable unbound
  systemctl restart unbound
}

install_pihole_if_missing() {
  if command -v pihole-FTL >/dev/null 2>&1 && systemctl list-unit-files pihole-FTL.service --no-legend >/dev/null 2>&1; then
    echo
    echo "=== Pi-hole already installed ==="
    return 0
  fi

  echo
  echo "=== Installing Pi-hole ==="

  mkdir -p /etc/pihole

  cat > /etc/pihole/setupVars.conf <<VARSEOF
PIHOLE_INTERFACE=$LAN
IPV4_ADDRESS=$LAN_IP
IPV6_ADDRESS=
PIHOLE_DNS_1=127.0.0.1#5335
QUERY_LOGGING=true
INSTALL_WEB_SERVER=true
INSTALL_WEB_INTERFACE=true
LIGHTTPD_ENABLED=true
BLOCKING_ENABLED=true
DNSMASQ_LISTENING=single
VARSEOF

  installer="/tmp/lilhouse-pihole-basic-install.sh"
  curl -fsSL https://install.pi-hole.net -o "$installer"
  chmod +x "$installer"

  PIHOLE_SKIP_OS_CHECK=true bash "$installer" --unattended
}

configure_pihole() {
  echo
  echo "=== Configuring Pi-hole DNS/DHCP ==="

  if ! command -v pihole-FTL >/dev/null 2>&1; then
    echo "ERROR: pihole-FTL missing after install." >&2
    exit 2
  fi

  mkdir -p /etc/dnsmasq.d

  cat > /etc/dnsmasq.d/02-lilhouse-dhcp.conf <<DNSMASQEOF
# Generated by LilHouse Agentic Router appliance installer
interface=$LAN
bind-interfaces
dhcp-authoritative
dhcp-range=$DHCP_START,$DHCP_END,24h
dhcp-option=option:router,$LAN_IP
dhcp-option=option:dns-server,$LAN_IP
DNSMASQEOF

  # Pi-hole v6/FTL preferred config path. If these fail, the installer must fail.
  pihole-FTL --config dns.upstreams '[ "127.0.0.1#5335" ]'
  pihole-FTL --config webserver.port "${LAN_IP}:80o,${LAN_IP}:443os"

  systemctl enable pihole-FTL
  systemctl restart pihole-FTL
}

configure_nftables() {
  echo
  echo "=== Preparing base nftables ruleset ==="

  cat > /etc/nftables.conf <<EOF
#!/usr/sbin/nft -f
# Generated by LilHouse Agentic Router appliance installer

flush ruleset

table inet lilhouse_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    iifname "lo" accept
    ct state established,related accept

    # LAN-side router services: DNS, DHCP, Pi-hole web/admin, SSH/admin.
    iifname "$LAN" accept

    # WAN-side DHCP client replies.
    iifname "$WAN" udp sport 67 udp dport 68 accept

    # Basic diagnostics; keep WAN ping allowed for appliance troubleshooting.
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    counter drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;

    ct state established,related accept
    iifname "$LAN" oifname "$WAN" accept

    counter drop
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}

table ip lilhouse_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;

    ip saddr $LAN_NET oifname "$WAN" masquerade
  }
}
EOF

  nft -f /etc/nftables.conf
  systemctl enable --now nftables
}

configure_cake() {
  echo
  echo "=== Configuring required CAKE/SQM ==="

  mkdir -p /etc/lilhouse /usr/local/sbin

  cat > /etc/lilhouse/cake.env <<EOF
# Generated by LilHouse Agentic Router appliance installer
LILHOUSE_CAKE_ENABLED=true
LILHOUSE_CAKE_WAN=$WAN
LILHOUSE_CAKE_IFB=$CAKE_IFB
LILHOUSE_CAKE_DOWN=$CAKE_DOWN
LILHOUSE_CAKE_UP=$CAKE_UP
LILHOUSE_CAKE_QDISC=cake
LILHOUSE_CAKE_DIFFSERV=diffserv4
LILHOUSE_CAKE_ISOLATION=triple-isolate
LILHOUSE_CAKE_NAT=true
LILHOUSE_CAKE_SPLIT_GSO=true
LILHOUSE_CAKE_RTT=100ms
LILHOUSE_CAKE_UPLOAD_ACK_FILTER=true
LILHOUSE_CAKE_DOWNLOAD_ACK_FILTER=false
EOF

  cat > /usr/local/sbin/lilhouse-cake-apply <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="/etc/lilhouse/cake.env"
test -f "$ENV_FILE" || { echo "missing $ENV_FILE" >&2; exit 2; }

# shellcheck disable=SC1090
. "$ENV_FILE"

WAN="${LILHOUSE_CAKE_WAN:?missing LILHOUSE_CAKE_WAN}"
IFB="${LILHOUSE_CAKE_IFB:-ifb0}"
DOWN="${LILHOUSE_CAKE_DOWN:-100mbit}"
UP="${LILHOUSE_CAKE_UP:-20mbit}"
RTT="${LILHOUSE_CAKE_RTT:-100ms}"

modprobe ifb numifbs=1 2>/dev/null || modprobe ifb 2>/dev/null || true
modprobe sch_cake 2>/dev/null || true
modprobe act_mirred 2>/dev/null || true
modprobe cls_matchall 2>/dev/null || true

if ! ip link show dev "$IFB" >/dev/null 2>&1; then
  ip link add "$IFB" type ifb 2>/dev/null || true
fi
ip link set dev "$IFB" up

tc qdisc del dev "$WAN" clsact 2>/dev/null || true
tc qdisc add dev "$WAN" clsact

tc filter replace dev "$WAN" ingress protocol all matchall \
  action mirred egress redirect dev "$IFB"

tc qdisc replace dev "$IFB" root cake \
  bandwidth "$DOWN" diffserv4 triple-isolate nat split-gso rtt "$RTT"

tc qdisc replace dev "$WAN" root cake \
  bandwidth "$UP" diffserv4 triple-isolate nat split-gso ack-filter rtt "$RTT"

tc qdisc show dev "$WAN" | grep -q cake
tc qdisc show dev "$IFB" | grep -q cake

echo "CAKE active: wan=$WAN ifb=$IFB down=$DOWN up=$UP"
EOF

  chmod +x /usr/local/sbin/lilhouse-cake-apply

  cat > /etc/systemd/system/lilhouse-cake.service <<'EOF'
[Unit]
Description=LilHouse CAKE/SQM runtime setup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/lilhouse-cake-apply

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable --now lilhouse-cake.service
}

verify_required_services() {
  echo
  echo "=== Verifying required appliance services ==="

  failed=0

  for svc in systemd-networkd nftables unbound pihole-FTL lilhouse-cake.service lilhouse-current-state.timer lilhouse-storage-health.timer; do
    if systemctl is-active --quiet "$svc"; then
      echo "OK: $svc"
    else
      echo "FAIL: $svc"
      failed=1
    fi
  done

  if [ "$failed" -ne 0 ]; then
    echo "ERROR: one or more required appliance services are not active." >&2
    exit 2
  fi
}

main() {
  need_root
  need_yes
  need_debian_systemd
  need_iface "$WAN" "WAN"
  need_iface "$LAN" "LAN"

  if [ "$WAN" = "$LAN" ]; then
    echo "ERROR: WAN and LAN must be different interfaces." >&2
    exit 2
  fi

  echo
  echo "LilHouse Agentic Router appliance install"
  echo "wan=$WAN"
  echo "lan=$LAN"
  echo "lan_cidr=$LAN_CIDR"
  echo "lan_net=$LAN_NET"
  echo "dhcp_start=$DHCP_START"
  echo "dhcp_end=$DHCP_END"
  echo "cake_down=$CAKE_DOWN"
  echo "cake_up=$CAKE_UP"

  apt_install_base
  install_lilhouse_core
  configure_lan_networkd
  configure_unbound
  install_pihole_if_missing
  configure_pihole

  systemctl daemon-reload
  configure_nftables
  configure_cake
  systemctl enable --now lilhouse-current-state.timer
  systemctl enable --now lilhouse-storage-health.timer

  verify_required_services

  echo
  echo "LilHouse appliance preparation complete."

  if [ "$PREPARE_ONLY" -eq 1 ]; then
    exit 0
  fi

  echo "Full final deploy chain is handled by easy-install/live orchestrator for now."
}

main "$@"
