#!/usr/bin/env python3
import argparse
import json
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


TIMER_NAME = "lilhouse-router-rollback.timer"
SERVICE_NAME = "lilhouse-router-rollback.service"


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def load_json(path):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except Exception as e:
        raise SystemExit(f"failed to read JSON {path}: {e}")


def run_cmd(argv):
    exe = shutil.which(argv[0])
    if not exe:
        return {
            "argv": argv,
            "available": False,
            "returncode": None,
            "stdout": "",
            "stderr": f"{argv[0]} not found",
            "ok": False,
        }

    p = subprocess.run(
        [exe, *argv[1:]],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    return {
        "argv": argv,
        "available": True,
        "returncode": p.returncode,
        "stdout": p.stdout.strip(),
        "stderr": p.stderr.strip(),
        "ok": p.returncode == 0,
    }


def unit_path(root, unit_name):
    return root / "etc/systemd/system" / unit_name


def main():
    ap = argparse.ArgumentParser(description="Start the LilHouse rollback guard timer.")
    ap.add_argument("--rollback-guard-report", required=True)
    ap.add_argument("--target-root", default="/")
    ap.add_argument("--yes", action="store_true", help="Required to start rollback guard.")
    ap.add_argument("--allow-live-root", action="store_true", help="Required when --target-root /.")
    ap.add_argument("--simulate", action="store_true", help="Do not call systemctl; write a simulated success report.")
    ap.add_argument("--out", default="")
    args = ap.parse_args()

    target_root = Path(args.target_root).resolve()

    if not args.yes:
        print("ERROR: refusing to start rollback guard without --yes", file=sys.stderr)
        return 2

    if target_root == Path("/") and not args.allow_live_root:
        print("ERROR: refusing to start rollback guard on live / without --allow-live-root", file=sys.stderr)
        return 2

    guard = load_json(args.rollback_guard_report)

    if guard.get("schema") != "lilhouse.router_rollback_guard.v1":
        print("ERROR: rollback guard report schema mismatch", file=sys.stderr)
        return 2

    if guard.get("ok") is not True:
        print("ERROR: rollback guard report is not OK", file=sys.stderr)
        return 2

    if guard.get("summary", {}).get("ready_for_rollback_start") is not True:
        print("ERROR: rollback guard did not approve rollback start", file=sys.stderr)
        return 2

    service = unit_path(target_root, SERVICE_NAME)
    timer = unit_path(target_root, TIMER_NAME)

    if not service.exists():
        print(f"ERROR: missing rollback service unit: {service}", file=sys.stderr)
        return 2

    if not timer.exists():
        print(f"ERROR: missing rollback timer unit: {timer}", file=sys.stderr)
        return 2

    commands = []
    timer_started = False

    if target_root == Path("/") and not args.simulate:
        commands.append(run_cmd(["systemctl", "daemon-reload"]))
        commands.append(run_cmd(["systemctl", "enable", "--now", TIMER_NAME]))
        timer_started = all(c["ok"] for c in commands)
    else:
        commands.append({
            "argv": ["systemctl", "daemon-reload"],
            "available": shutil.which("systemctl") is not None,
            "returncode": 0,
            "stdout": "",
            "stderr": "",
            "ok": True,
            "simulated": True,
        })
        commands.append({
            "argv": ["systemctl", "enable", "--now", TIMER_NAME],
            "available": shutil.which("systemctl") is not None,
            "returncode": 0,
            "stdout": "",
            "stderr": "",
            "ok": True,
            "simulated": True,
        })
        timer_started = True

    report = {
        "schema": "lilhouse.router_rollback_start.v1",
        "ok": timer_started,
        "generated_at": now_iso(),
        "mode": "rollback-start" if target_root == Path("/") and not args.simulate else "rollback-start-simulated",
        "inputs": {
            "rollback_guard_report": str(Path(args.rollback_guard_report)),
            "target_root": str(target_root),
            "allow_live_root": args.allow_live_root,
            "yes": args.yes,
            "simulate": args.simulate,
        },
        "safety": {
            "apply": False,
            "live_changes": target_root == Path("/") and not args.simulate,
            "copies_files": False,
            "writes_config": False,
            "runs_services": target_root == Path("/") and not args.simulate,
            "starts_rollback_timer": timer_started,
            "starts_router_services": False,
            "modifies_router_config": False,
            "touches_network": False,
            "touches_firewall": False,
            "touches_dns": False,
            "touches_dhcp": False,
            "touches_cake": False,
        },
        "summary": {
            "rollback_timer": TIMER_NAME,
            "rollback_timer_started": timer_started,
            "ready_for_live_config_copy": timer_started,
            "ready_for_live_apply": False,
            "safe_to_apply_live": False,
            "next_gate": "live-config-copy",
        },
        "commands": commands,
    }

    if args.out:
        out = Path(args.out)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if report["ok"] else 2


if __name__ == "__main__":
    sys.exit(main())
