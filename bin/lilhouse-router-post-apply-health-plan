#!/usr/bin/env python3
import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Plan post-apply health checks required before cancelling rollback."
    )
    parser.add_argument("apply_plan", help="router apply-plan JSON.")
    parser.add_argument("--lan-ip", default="10.23.0.1")
    parser.add_argument("--dns-test-name", default="example.com")
    parser.add_argument("--wan-test-ip", default="1.1.1.1")
    parser.add_argument("--timeout-seconds", type=int, default=120)
    args = parser.parse_args()

    apply_plan_path = Path(args.apply_plan).resolve()
    if not apply_plan_path.is_file():
        print(f"ERROR: apply plan not found: {apply_plan_path}", file=sys.stderr)
        return 1

    plan = json.loads(apply_plan_path.read_text(encoding="utf-8"))
    errors = []

    if plan.get("schema") != "lilhouse.router_apply_plan.v1":
        errors.append("input is not a router apply-plan report")
    if plan.get("ok") is not True:
        errors.append("apply plan is not OK")
    if plan.get("apply") is not False:
        errors.append("apply plan must be non-applying")
    if plan.get("live_changes") is not False:
        errors.append("apply plan must declare live_changes false")

    if args.timeout_seconds < 30 or args.timeout_seconds > 900:
        errors.append("timeout-seconds must be between 30 and 900")

    checks = [
        {
            "id": "local_admin_path",
            "description": "Confirm local console or out-of-band recovery path remains available.",
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "id": "lan_gateway_reachable",
            "description": "Confirm LAN gateway answers on the expected router address.",
            "target": args.lan_ip,
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "id": "dns_resolution",
            "description": "Confirm DNS resolution through router DNS stack.",
            "target": args.dns_test_name,
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "id": "wan_reachability",
            "description": "Confirm WAN reachability to a stable external IP.",
            "target": args.wan_test_ip,
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "id": "dhcp_service_state",
            "description": "Confirm DHCP provider is active or explicitly not managed by this apply.",
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "id": "firewall_service_state",
            "description": "Confirm nftables/firewall service is active after apply.",
            "required": True,
            "failure_action": "keep rollback armed",
        },
        {
            "id": "rollback_timer_state",
            "description": "Confirm rollback timer is still armed until every health check passes.",
            "required": True,
            "failure_action": "do not cancel rollback",
        },
    ]

    result = {
        "schema": "lilhouse.router_post_apply_health_plan.v1",
        "mode": "post-apply-health-plan",
        "apply": False,
        "live_changes": False,
        "generated": datetime.now(timezone.utc).isoformat(),
        "ok": not errors,
        "error_count": len(errors),
        "errors": errors,
        "apply_plan": str(apply_plan_path),
        "timeout_seconds": args.timeout_seconds,
        "checks": checks,
        "summary": {
            "required_check_count": sum(1 for c in checks if c["required"]),
            "requires_all_checks_pass": True,
            "rollback_cancel_allowed_only_after_pass": True,
            "safe_to_cancel_rollback_now": False,
            "safe_to_apply_live": False,
        },
    }

    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
