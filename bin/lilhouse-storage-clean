#!/usr/bin/env python3
import argparse
import json
import os
import sys
from pathlib import Path
from datetime import datetime, timezone

DEFAULT_STATE_DIR = os.environ.get("LILHOUSE_STATE_DIR", "/var/lib/lilhouse")
DEFAULT_LOG_DIR = os.environ.get("LILHOUSE_LOG_DIR", "/var/log/lilhouse")
DEFAULT_CONFIG_DIR = os.environ.get("LILHOUSE_CONFIG_DIR", "/etc/lilhouse")
DEFAULT_ARCHIVE_DIR = os.environ.get("LILHOUSE_ARCHIVE_DIR", "/var/lib/lilhouse/archive")

ACTIVE_JSON = {
    "current-state.json",
    "storage-health.json",
}

ACTIVE_JSONL = {
    "events.jsonl",
    "actions.jsonl",
    "proposals.jsonl",
}


def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat()


def human_bytes(num):
    try:
        num = float(num)
    except Exception:
        return "unknown"

    units = ["B", "KB", "MB", "GB", "TB"]
    for unit in units:
        if abs(num) < 1024.0:
            if unit == "B":
                return f"{int(num)} {unit}"
            return f"{num:.1f} {unit}"
        num /= 1024.0
    return f"{num:.1f} PB"


def safe_stat(path):
    try:
        st = path.stat()
        return {
            "exists": True,
            "bytes": st.st_size,
            "mtime": datetime.fromtimestamp(st.st_mtime, timezone.utc).astimezone().isoformat(),
            "age_seconds": max(0, int(datetime.now(timezone.utc).timestamp() - st.st_mtime)),
        }
    except Exception as exc:
        return {
            "exists": False,
            "bytes": 0,
            "mtime": None,
            "age_seconds": 0,
            "error": str(exc),
        }


def rel(path, base):
    try:
        return str(path.relative_to(base))
    except Exception:
        return str(path)


def candidate(action, path, reason, archive_target=None):
    info = safe_stat(path)
    return {
        "action": action,
        "path": str(path),
        "bytes": info.get("bytes", 0),
        "human": human_bytes(info.get("bytes", 0)),
        "mtime": info.get("mtime"),
        "reason": reason,
        "archive_target": str(archive_target) if archive_target else None,
        "executes_now": False,
    }


def walk_files(root):
    root = Path(root)
    if not root.exists():
        return
    if root.is_file():
        yield root
        return

    for dirpath, dirs, files in os.walk(root, topdown=True):
        base = Path(dirpath)

        # Do not include already archived files as cleanup candidates in this first planner.
        dirs[:] = [
            d for d in dirs
            if d not in {".git", "__pycache__", "archive", "archives"}
        ]

        for name in files:
            yield base / name


def build_plan(args):
    state_dir = Path(args.state_dir)
    log_dir = Path(args.log_dir)
    config_dir = Path(args.config_dir)
    archive_dir = Path(args.archive_dir)

    max_hot_bytes = args.max_hot_bytes
    max_report_age_seconds = args.max_report_age_days * 86400

    preserve = []
    candidates = []

    # Preserve active config directory as a category.
    preserve.append({
        "path": str(config_dir),
        "reason": "active LilHouse config is never cleaned by this planner",
    })

    # Active state files remain readable and uncompressed.
    for name in sorted(ACTIVE_JSON):
        p = state_dir / name
        if p.exists():
            preserve.append({
                "path": str(p),
                "reason": "latest state remains plain JSON",
            })

    # Active ledgers are preserved, but may be planned for future archive/checkpoint.
    date = datetime.now(timezone.utc).strftime("%Y%m%d")
    for name in sorted(ACTIVE_JSONL):
        p = state_dir / name
        if not p.exists():
            continue

        info = safe_stat(p)
        preserve.append({
            "path": str(p),
            "reason": "active live ledger remains accessible",
        })

        if info["bytes"] > max_hot_bytes:
            target = archive_dir / "ledgers" / f"{name}.{date}.gz"
            candidates.append(candidate(
                "would_copy_compress_and_index_active_ledger",
                p,
                f"active ledger is larger than hot threshold {human_bytes(max_hot_bytes)}; future implementation must archive before checkpointing",
                target,
            ))

    # Older JSON reports in state dir can be compressed, except latest/current state.
    for p in walk_files(state_dir):
        if p.name in ACTIVE_JSON or p.name in ACTIVE_JSONL:
            continue
        if "archive" in p.parts or "archives" in p.parts:
            continue
        if not p.name.endswith(".json"):
            continue

        info = safe_stat(p)
        if info["age_seconds"] >= max_report_age_seconds:
            target = archive_dir / "reports" / f"{rel(p, state_dir).replace('/', '__')}.gz"
            candidates.append(candidate(
                "would_compress_report",
                p,
                f"report is older than {args.max_report_age_days} days",
                target,
            ))
        else:
            preserve.append({
                "path": str(p),
                "reason": "recent JSON report remains hot",
            })

    # Logs can be compressed, but not deleted.
    for p in walk_files(log_dir):
        if p.name.endswith(".gz"):
            preserve.append({
                "path": str(p),
                "reason": "already compressed log/archive",
            })
            continue

        info = safe_stat(p)
        if info["bytes"] > max_hot_bytes or info["age_seconds"] >= max_report_age_seconds:
            target = archive_dir / "logs" / f"{rel(p, log_dir).replace('/', '__')}.gz"
            candidates.append(candidate(
                "would_compress_log",
                p,
                f"log is older than {args.max_report_age_days} days or larger than {human_bytes(max_hot_bytes)}",
                target,
            ))
        else:
            preserve.append({
                "path": str(p),
                "reason": "recent/small log remains hot",
            })

    total_candidate_bytes = sum(c["bytes"] for c in candidates)

    return {
        "schema": "lilhouse.storage_clean_plan.v1",
        "ok": True,
        "ts": now_iso(),
        "mode": "dry_run_only",
        "executes_changes": False,
        "deletes_files": False,
        "policy": {
            "lossless_by_default": True,
            "raw_history_must_remain_accessible": True,
            "summaries_are_additive": True,
            "compress_before_cleanup": True,
        },
        "inputs": {
            "state_dir": str(state_dir),
            "log_dir": str(log_dir),
            "config_dir": str(config_dir),
            "archive_dir": str(archive_dir),
            "max_hot_bytes": max_hot_bytes,
            "max_report_age_days": args.max_report_age_days,
        },
        "preserve": preserve,
        "candidates": candidates,
        "summary": {
            "candidate_count": len(candidates),
            "preserve_count": len(preserve),
            "candidate_bytes": total_candidate_bytes,
            "candidate_human": human_bytes(total_candidate_bytes),
            "delete_count": 0,
            "next_step": "review_only_no_changes_made",
        },
    }


def print_human(plan):
    print()
    print("======================================")
    print(" LilHouse Storage Clean Dry Run")
    print("======================================")
    print()
    print("Safety:")
    print("  mode: dry-run only")
    print("  executes changes: no")
    print("  deletes files: no")
    print("  lossless history: required")
    print()
    print("Would archive/compress:")
    if plan["candidates"]:
        for item in plan["candidates"]:
            print(f"  - {item['action']}")
            print(f"    source: {item['path']}")
            print(f"    size:   {item['human']}")
            print(f"    reason: {item['reason']}")
            if item.get("archive_target"):
                print(f"    target: {item['archive_target']}")
    else:
        print("  none")
    print()
    print("Would preserve:")
    for item in plan["preserve"][:20]:
        print(f"  - {item['path']}")
        print(f"    reason: {item['reason']}")
    if len(plan["preserve"]) > 20:
        print(f"  ... {len(plan['preserve']) - 20} more preserved items")
    print()
    print(f"Candidate total: {plan['summary']['candidate_human']}")
    print("Status: OK")


def main():
    ap = argparse.ArgumentParser(description="Plan lossless LilHouse storage cleanup/archive actions.")
    ap.add_argument("--dry-run", action="store_true", help="Required. Print what would happen without changing files.")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--state-dir", default=DEFAULT_STATE_DIR)
    ap.add_argument("--log-dir", default=DEFAULT_LOG_DIR)
    ap.add_argument("--config-dir", default=DEFAULT_CONFIG_DIR)
    ap.add_argument("--archive-dir", default=DEFAULT_ARCHIVE_DIR)
    ap.add_argument("--max-hot-bytes", type=int, default=5 * 1024 * 1024)
    ap.add_argument("--max-report-age-days", type=int, default=7)
    args = ap.parse_args()

    if not args.dry_run:
        print("ERROR: this alpha command currently only supports --dry-run.", file=sys.stderr)
        print("Try: sudo lilhouse-storage-clean --dry-run", file=sys.stderr)
        return 2

    plan = build_plan(args)

    if args.json:
        print(json.dumps(plan, indent=2, sort_keys=True))
    else:
        print_human(plan)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
