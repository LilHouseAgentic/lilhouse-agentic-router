#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import sys
from pathlib import Path
from datetime import datetime, timezone

REQUIRED_KEYS = [
    "schema",
    "version",
    "default_mode",
    "principles",
    "agent_workflow",
    "storage_rules",
    "decision_classes",
    "command_tiers",
    "required_readiness_tools",
]

REQUIRED_DECISIONS = [
    "observe",
    "watch",
    "propose",
    "alert",
    "guarded_execute_request",
    "blocked",
]

REQUIRED_TIERS = [
    "observe_read_only",
    "additive_write_requires_yes",
    "guarded_execute_requires_operator",
    "forbidden_for_agents",
]

BUILTIN_POLICY = {
    "schema": "lilhouse.agent_policy.v1",
    "version": "0.5.0-alpha",
    "default_mode": "read_only_observe",
    "principles": ["Observe before proposing.", "Raw history remains source of truth."],
    "agent_workflow": ["Read status.", "Read summary.", "Query evidence.", "Propose before executing."],
    "storage_rules": {
        "raw_history_preserved": True,
        "summaries_are_additive": True,
        "summaries_replace_raw_history": False,
        "agent_may_delete_history": False,
        "agent_may_truncate_ledgers": False,
        "agent_may_preview_history_with_line_limits": True,
    },
    "decision_classes": {
        "observe": "Report status only.",
        "watch": "Continue monitoring.",
        "propose": "Suggest without executing.",
        "alert": "Notify operator.",
        "guarded_execute_request": "Ask approval for guarded command.",
        "blocked": "Refuse unsafe action.",
    },
    "command_tiers": {
        "observe_read_only": ["lilhouse-storage-maintenance --dry-run"],
        "additive_write_requires_yes": ["lilhouse-storage-summary --write-summary --yes"],
        "guarded_execute_requires_operator": ["lilhouse-storage-archive --execute --yes"],
        "forbidden_for_agents": ["delete arbitrary files", "truncate active ledgers"],
    },
    "required_readiness_tools": [
        "lilhouse-current-state",
        "lilhouse-status",
        "lilhouse-router-status",
        "lilhouse-router-doctor",
        "lilhouse-agent-propose",
        "lilhouse-client-readiness",
        "lilhouse-storage-status",
        "lilhouse-storage-clean",
        "lilhouse-storage-index",
        "lilhouse-storage-archive",
        "lilhouse-storage-ledger-checkpoint",
        "lilhouse-storage-query",
        "lilhouse-storage-summary",
        "lilhouse-storage-maintenance",
    ],
}

def now_iso():
    return datetime.now(timezone.utc).astimezone().isoformat()

def default_policy_path():
    repo_policy = Path(__file__).resolve().parent.parent / "config" / "lilhouse-agent-policy.example.json"
    if repo_policy.exists():
        return repo_policy
    installed_policy = Path("/etc/lilhouse/agent-policy.json")
    if installed_policy.exists():
        return installed_policy
    return None

def load_policy(path_text):
    if path_text:
        p = Path(path_text)
    else:
        p = default_policy_path()
    if p and p.exists():
        with p.open("r", encoding="utf-8") as f:
            return json.load(f), str(p)
    return BUILTIN_POLICY, "builtin"

def sibling_tool_exists(name):
    p = Path(__file__).resolve().parent / name
    return p.exists() and os.access(p, os.X_OK), str(p)

def command_exists(name):
    sibling_ok, sibling_path = sibling_tool_exists(name)
    if sibling_ok:
        return {"name": name, "exists": True, "path": sibling_path, "source": "sibling_bin"}
    found = shutil.which(name)
    if found:
        return {"name": name, "exists": True, "path": found, "source": "path"}
    return {"name": name, "exists": False, "path": None, "source": None}

def validate_policy(policy):
    errors = []
    for key in REQUIRED_KEYS:
        if key not in policy:
            errors.append("missing top-level policy key: " + key)
    if policy.get("schema") != "lilhouse.agent_policy.v1":
        errors.append("schema must be lilhouse.agent_policy.v1")
    storage = policy.get("storage_rules", {})
    if storage.get("raw_history_preserved") is not True:
        errors.append("raw_history_preserved must be true")
    if storage.get("summaries_replace_raw_history") is not False:
        errors.append("summaries_replace_raw_history must be false")
    if storage.get("agent_may_delete_history") is not False:
        errors.append("agent_may_delete_history must be false")
    if storage.get("agent_may_truncate_ledgers") is not False:
        errors.append("agent_may_truncate_ledgers must be false")
    decisions = policy.get("decision_classes", {})
    for decision in REQUIRED_DECISIONS:
        if decision not in decisions:
            errors.append("missing decision class: " + decision)
    tiers = policy.get("command_tiers", {})
    for tier in REQUIRED_TIERS:
        if tier not in tiers:
            errors.append("missing command tier: " + tier)
    return errors

def build_report(args):
    policy, source = load_policy(args.policy_file)
    policy_errors = validate_policy(policy)
    tools = [command_exists(name) for name in policy.get("required_readiness_tools", [])]
    missing_tools = [tool for tool in tools if not tool["exists"]]
    ok = not policy_errors and not missing_tools
    return {
        "schema": "lilhouse.agent_readiness.v1",
        "ok": ok,
        "ts": now_iso(),
        "mode": "read_only_check",
        "writes_files": False,
        "deletes_files": False,
        "executes_router_changes": False,
        "policy_source": source,
        "policy_schema": policy.get("schema"),
        "policy_version": policy.get("version"),
        "default_mode": policy.get("default_mode"),
        "policy_valid": not policy_errors,
        "policy_errors": policy_errors,
        "required_tools_count": len(tools),
        "missing_tools_count": len(missing_tools),
        "tools": tools,
        "missing_tools": missing_tools,
        "storage_rules": policy.get("storage_rules", {}),
        "decision_classes": policy.get("decision_classes", {}),
        "command_tiers": policy.get("command_tiers", {}),
        "agent_workflow": policy.get("agent_workflow", []),
        "principles": policy.get("principles", []),
        "readiness_interpretation": {
            "can_create_read_only_observer_agents_later": ok,
            "can_create_autonomous_writer_agents_now": False,
            "reason": "This release defines the safety contract. It does not grant autonomous write authority.",
        },
    }

def print_human(report):
    print()
    print("======================================")
    print(" LilHouse Agent Readiness")
    print("======================================")
    print()
    print("Safety:")
    print("  mode: read-only check")
    print("  writes files: no")
    print("  deletes files: no")
    print("  executes router changes: no")
    print()
    print("Policy: " + str(report["policy_source"]))
    print("Policy valid: " + ("yes" if report["policy_valid"] else "no"))
    print("Default agent mode: " + str(report["default_mode"]))
    print()
    if report["policy_errors"]:
        print("Policy errors:")
        for err in report["policy_errors"]:
            print("  - " + err)
        print()
    print("Required tools:")
    for tool in report["tools"]:
        mark = "OK" if tool["exists"] else "MISSING"
        print("  " + mark + "  " + tool["name"] + " -> " + str(tool["path"] or "missing"))
    print()
    print("Readiness:")
    interp = report["readiness_interpretation"]
    print("  read-only observer agents later: " + str(interp["can_create_read_only_observer_agents_later"]))
    print("  autonomous writer agents now:    " + str(interp["can_create_autonomous_writer_agents_now"]))
    print("  reason: " + interp["reason"])
    print()
    print("Overall status: " + ("OK" if report["ok"] else "CHECK REQUIRED"))

def main():
    ap = argparse.ArgumentParser(description="Check the LilHouse future-agent safety contract.")
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--policy-file", default="")
    args = ap.parse_args()
    if not args.check:
        print("ERROR: lilhouse-agent-readiness currently supports --check only.", file=sys.stderr)
        print("Try: lilhouse-agent-readiness --check", file=sys.stderr)
        return 2
    report = build_report(args)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_human(report)
    return 0 if report["ok"] else 1

if __name__ == "__main__":
    raise SystemExit(main())
