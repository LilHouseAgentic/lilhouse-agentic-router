#!/usr/bin/env bash
set -euo pipefail

OUT_DIR="${LILHOUSE_STATE_DIR:-./state}/router-wizard"
WAN=""
LAN=""
LAN_IP="192.168.2.1"
SUBNET="192.168.2.0/24"
DHCP_START="192.168.2.100"
DHCP_END="192.168.2.200"
ENABLE_CAKE=0
ENABLE_IPV6=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --out-dir)
      OUT_DIR="${2:-}"
      shift 2
      ;;
    --wan)
      WAN="${2:-}"
      shift 2
      ;;
    --lan)
      LAN="${2:-}"
      shift 2
      ;;
    --lan-ip)
      LAN_IP="${2:-}"
      shift 2
      ;;
    --subnet)
      SUBNET="${2:-}"
      shift 2
      ;;
    --dhcp-start)
      DHCP_START="${2:-}"
      shift 2
      ;;
    --dhcp-end)
      DHCP_END="${2:-}"
      shift 2
      ;;
    --enable-cake)
      ENABLE_CAKE=1
      shift
      ;;
    --enable-ipv6)
      ENABLE_IPV6=1
      shift
      ;;
    -h|--help)
      echo "Usage: lilhouse-router-wizard [options]"
      echo
      echo "Plan-only wizard shell. No system changes are made."
      echo
      echo "Options:"
      echo "  --out-dir PATH"
      echo "  --wan IFACE"
      echo "  --lan IFACE"
      echo "  --lan-ip IP"
      echo "  --subnet CIDR"
      echo "  --dhcp-start IP"
      echo "  --dhcp-end IP"
      echo "  --enable-cake"
      echo "  --enable-ipv6"
      exit 0
      ;;
    *)
      echo "Unknown argument: $1"
      exit 1
      ;;
  esac
done

mkdir -p "$OUT_DIR"

INTERFACE_REPORT="$OUT_DIR/interface-report.json"
PLAN_JSON="$OUT_DIR/router-plan.json"
PLAN_SUMMARY="$OUT_DIR/router-plan-summary.txt"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

"$SCRIPT_DIR/lilhouse-interface-report" >"$INTERFACE_REPORT"

if [ -z "$WAN" ] || [ -z "$LAN" ]; then
  guessed="$(
    python3 - "$INTERFACE_REPORT" <<'PY'
import json
import sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
wan = ""
lan = ""

for iface in data.get("interfaces", []):
    roles = iface.get("likely_roles", [])
    if not wan and "wan_candidate" in roles:
        wan = iface.get("name", "")
    if not lan and "lan_candidate" in roles:
        lan = iface.get("name", "")

print(wan)
print(lan)
PY
  )"

  WAN="${WAN:-$(printf '%s\n' "$guessed" | sed -n '1p')}"
  LAN="${LAN:-$(printf '%s\n' "$guessed" | sed -n '2p')}"
fi

if [ -z "$WAN" ] || [ -z "$LAN" ]; then
  echo "Could not auto-detect both WAN and LAN."
  echo "Pass --wan IFACE and --lan IFACE."
  echo "Interface report written to: $INTERFACE_REPORT"
  exit 2
fi

plan_args=(
  --wan "$WAN"
  --lan "$LAN"
  --lan-ip "$LAN_IP"
  --subnet "$SUBNET"
  --dhcp-start "$DHCP_START"
  --dhcp-end "$DHCP_END"
  --output "$PLAN_JSON"
)

if [ "$ENABLE_CAKE" -eq 1 ]; then
  plan_args+=(--enable-cake)
fi

if [ "$ENABLE_IPV6" -eq 1 ]; then
  plan_args+=(--enable-ipv6)
fi

"$SCRIPT_DIR/lilhouse-router-plan" "${plan_args[@]}"
"$SCRIPT_DIR/lilhouse-router-plan-summary" "$PLAN_JSON" >"$PLAN_SUMMARY"

PREVIEW_ROOT="$OUT_DIR/preview"
LAN_NETWORK_FILE="$PREVIEW_ROOT/etc/systemd/network/20-lilhouse-lan.network"
mkdir -p "$(dirname "$LAN_NETWORK_FILE")"

LAN_PREFIX="${SUBNET#*/}"
if [ "$LAN_PREFIX" = "$SUBNET" ]; then
  LAN_PREFIX="24"
fi

cat >"$LAN_NETWORK_FILE" <<EOF
# LilHouse router deploy generated networkd config
# Generated by LilHouse router wizard.
# Safe to stage/copy through the guarded live chain.

[Match]
Name=$LAN

[Network]
Address=$LAN_IP/$LAN_PREFIX
IPv4Forwarding=yes
IPv6Forwarding=yes
IPv6AcceptRA=no

EOF

FORWARDING_FILE="$PREVIEW_ROOT/etc/sysctl.d/90-lilhouse-router-forwarding.conf"
mkdir -p "$(dirname "$FORWARDING_FILE")"

IPV6_FORWARDING="0"
if [ "$ENABLE_IPV6" -eq 1 ]; then
  IPV6_FORWARDING="1"
fi

cat >"$FORWARDING_FILE" <<EOF
# LilHouse router deploy preview
# This file was generated by the dry-run wizard.
# It has NOT been written to /etc/sysctl.d.

net.ipv4.ip_forward=1
net.ipv6.conf.all.forwarding=$IPV6_FORWARDING

EOF

NFTABLES_FILE="$PREVIEW_ROOT/etc/nftables.conf"
mkdir -p "$(dirname "$NFTABLES_FILE")"

cat >"$NFTABLES_FILE" <<EOF
# LilHouse router deploy preview nftables.conf
# This file was generated by the dry-run wizard.
# It has NOT been written to /etc/nftables.conf.

flush ruleset

table inet lilhouse_filter {
  chain input {
    type filter hook input priority 0; policy drop;

    iifname "lo" accept
    ct state established,related accept
    iifname "$LAN" accept
    iifname "$WAN" ip protocol icmp accept
    iifname "$WAN" ip6 nexthdr icmpv6 accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    ct state established,related accept
    iifname "$LAN" oifname "$WAN" accept
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}

table ip lilhouse_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;

    oifname "$WAN" ip saddr $SUBNET masquerade
  }
}
EOF

PIHOLE_DNS_PLAN_FILE="$PREVIEW_ROOT/etc/lilhouse/pihole-dns-plan.env"
mkdir -p "$(dirname "$PIHOLE_DNS_PLAN_FILE")"

cat >"$PIHOLE_DNS_PLAN_FILE" <<EOF
# LilHouse router deploy preview
# This is a safe Pi-hole DNS plan, not a direct pihole.toml replacement.
# It has NOT been written to /etc/pihole.

LILHOUSE_DNS_MODE=pihole-unbound
LILHOUSE_LAN_DNS_ADDRESS=$LAN_IP
LILHOUSE_PIHOLE_INTERFACE=$LAN
LILHOUSE_PIHOLE_LISTEN=lan_only
LILHOUSE_PIHOLE_UPSTREAM=127.0.0.1#5335
LILHOUSE_BLOCK_APPLE_PRIVATE_RELAY=planned
LILHOUSE_BLOCK_DOH_CANARY=planned
EOF

PIHOLE_DHCP_PLAN_FILE="$PREVIEW_ROOT/etc/lilhouse/pihole-dhcp-plan.env"
mkdir -p "$(dirname "$PIHOLE_DHCP_PLAN_FILE")"

cat >"$PIHOLE_DHCP_PLAN_FILE" <<EOF
# LilHouse router deploy preview
# This is a safe Pi-hole DHCP plan, not a direct pihole.toml replacement.
# It has NOT been written to /etc/pihole.

LILHOUSE_DHCP_PROVIDER=pihole-FTL
LILHOUSE_DHCP_INTERFACE=$LAN
LILHOUSE_DHCP_ROUTER=$LAN_IP
LILHOUSE_DHCP_START=$DHCP_START
LILHOUSE_DHCP_END=$DHCP_END
LILHOUSE_DHCP_AUTHORITATIVE=true
EOF

UNBOUND_FILE="$PREVIEW_ROOT/etc/unbound/unbound.conf.d/lilhouse.conf"
mkdir -p "$(dirname "$UNBOUND_FILE")"

cat >"$UNBOUND_FILE" <<EOF
# LilHouse router deploy preview
# This file was generated by the dry-run wizard.
# It has NOT been written to /etc/unbound/unbound.conf.d.

server:
  interface: 127.0.0.1
  port: 5335
  access-control: 127.0.0.0/8 allow
  do-ip4: yes
  do-ip6: yes
  do-udp: yes
  do-tcp: yes
  qname-minimisation: yes
  edns-buffer-size: 1232
  harden-glue: yes
  harden-dnssec-stripped: yes
  prefetch: yes
EOF

if [ "$ENABLE_CAKE" -eq 1 ]; then
  CAKE_ENV_FILE="$PREVIEW_ROOT/etc/lilhouse/cake.env"
  mkdir -p "$(dirname "$CAKE_ENV_FILE")"

  cat >"$CAKE_ENV_FILE" <<EOF
# LilHouse router deploy preview
# This file was generated by the dry-run wizard.
# It has NOT been written to /etc/lilhouse/cake.env.

LILHOUSE_CAKE_ENABLED=true
LILHOUSE_CAKE_WAN=$WAN
LILHOUSE_CAKE_IFB=ifb0
LILHOUSE_CAKE_QDISC=cake
LILHOUSE_CAKE_DIFFSERV=diffserv4
LILHOUSE_CAKE_ISOLATION=triple-isolate
LILHOUSE_CAKE_NAT=true
LILHOUSE_CAKE_SPLIT_GSO=true
LILHOUSE_CAKE_RTT=100ms
LILHOUSE_CAKE_UPLOAD_ACK_FILTER=true
LILHOUSE_CAKE_DOWNLOAD_ACK_FILTER=false
LILHOUSE_CAKE_BANDWIDTH_MODE=requires_baseline_or_dynamic_worker
EOF
fi

if [ "$ENABLE_IPV6" -eq 1 ]; then
  IPV6_PLAN_FILE="$PREVIEW_ROOT/etc/lilhouse/ipv6-plan.env"
  mkdir -p "$(dirname "$IPV6_PLAN_FILE")"

  cat >"$IPV6_PLAN_FILE" <<EOF
# LilHouse router deploy preview
# This file was generated by the dry-run wizard.
# It has NOT been written to /etc/lilhouse/ipv6-plan.env.

LILHOUSE_IPV6_ENABLED=true
LILHOUSE_IPV6_WAN=$WAN
LILHOUSE_IPV6_LAN=$LAN
LILHOUSE_IPV6_FORWARDING=true
LILHOUSE_IPV6_PREFIX_SOURCE=upstream_delegated_prefix_or_existing_global_lan_prefix
LILHOUSE_IPV6_LAN_RA=planned
LILHOUSE_IPV6_NAT66=false
LILHOUSE_IPV6_FIREWALL_POLICY=allow_lan_to_wan_drop_unsolicited_wan
LILHOUSE_IPV6_INBOUND_SSH=explicit_opt_in_only
EOF
fi

SYSTEMD_PREVIEW_DIR="$PREVIEW_ROOT/etc/systemd/system"
mkdir -p "$SYSTEMD_PREVIEW_DIR"

cat >"$SYSTEMD_PREVIEW_DIR/lilhouse-current-state.service" <<EOF
# LilHouse router deploy preview
# This file was generated by the dry-run wizard.
# It has NOT been written to /etc/systemd/system.

[Unit]
Description=LilHouse current router state collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lilhouse-current-state
EOF

cat >"$SYSTEMD_PREVIEW_DIR/lilhouse-current-state.timer" <<EOF
# LilHouse router deploy preview
# This file was generated by the dry-run wizard.
# It has NOT been written to /etc/systemd/system.

[Unit]
Description=Run LilHouse current state collector regularly

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
EOF

cat >"$SYSTEMD_PREVIEW_DIR/lilhouse-storage-health.service" <<EOF
# LilHouse router deploy preview
# This file was generated by the dry-run wizard.
# It has NOT been written to /etc/systemd/system.

[Unit]
Description=LilHouse storage health collector
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/lilhouse-storage-health
EOF

cat >"$SYSTEMD_PREVIEW_DIR/lilhouse-storage-health.timer" <<EOF
# LilHouse router deploy preview
# This file was generated by the dry-run wizard.
# It has NOT been written to /etc/systemd/system.

[Unit]
Description=Run LilHouse storage health collector regularly

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
EOF

MANIFEST_FILE="$PREVIEW_ROOT/MANIFEST.txt"

ROLLBACK_FILE="$PREVIEW_ROOT/ROLLBACK-NOTES.txt"

cat >"$ROLLBACK_FILE" <<EOF
LilHouse router deploy rollback preview

This file is generated for planning only.
No rollback action has been performed.

Router-deploy apply backs up these live paths before writing anything:

- /etc/systemd/network/20-lilhouse-lan.network
- /etc/sysctl.d/90-lilhouse-router-forwarding.conf
- /etc/nftables.conf
- /etc/lilhouse/cake.env
- /etc/pihole
- /etc/unbound/unbound.conf.d/lilhouse.conf
- /etc/systemd/system/lilhouse-current-state.service
- /etc/systemd/system/lilhouse-current-state.timer
- /etc/systemd/system/lilhouse-storage-health.service
- /etc/systemd/system/lilhouse-storage-health.timer

Rollback must be able to:

1. Stop newly enabled LilHouse timers/services.
2. Restore backed-up files exactly.
3. Reload systemd.
4. Reload sysctl only after config restore.
5. Restore firewall rules from backup before applying any new rules.
6. Restart DNS/DHCP services only after their configs are restored.
7. Leave a timestamped rollback report.

Live router safety rule:
Run router-deploy apply only when this host is ready to become the router.
EOF

VALIDATION_FILE="$PREVIEW_ROOT/VALIDATION-CHECKLIST.txt"

cat >"$VALIDATION_FILE" <<EOF
LilHouse router deploy validation checklist

This file is generated for planning only.
No validation has been applied to the live system.

Before router-deploy apply, the installer verifies:

Interface checks:
- WAN interface exists: $WAN
- LAN interface exists: $LAN
- WAN and LAN are not the same interface
- LAN static address does not conflict with an existing live address
- LAN subnet is valid: $SUBNET

Config syntax checks:
- systemd-networkd preview files parse cleanly
- sysctl preview values are valid
- nftables preview can be checked without applying
- Unbound preview config can be checked without replacing live config
- Pi-hole DNS/DHCP changes are translated through a version-aware method, not blind overwrite

Service checks:
- required commands exist before enabling timers
- generated systemd units pass systemd-analyze verify
- timers activate during router-deploy apply

Safety checks:
- backup directory exists and is writable
- rollback plan exists
- current SSH/admin session is protected from lockout
- firewall changes are staged with a timed rollback guard
- DNS/DHCP restart has a fallback path
- router-deploy apply requires --yes and explicit WAN/LAN interfaces

Live router safety rule:
Dry-run generates preview files. Router-deploy apply validates explicit interfaces and installs the router configuration.
EOF

{
  echo "LilHouse router deploy preview manifest"
  echo
  echo "This directory contains generated preview files only."
  echo "No files here have been written to the live system."
  echo
  echo "WAN interface: $WAN"
  echo "LAN interface: $LAN"
  echo "LAN address: $LAN_IP/$LAN_PREFIX"
  echo "LAN subnet: $SUBNET"
  echo "DHCP range: $DHCP_START - $DHCP_END"
  echo "Enable CAKE: $ENABLE_CAKE"
  echo "Enable IPv6: $ENABLE_IPV6"
  echo
  echo "Generated files:"
  find "$PREVIEW_ROOT" -type f | sed "s#^$PREVIEW_ROOT/##" | sort | sed "s#^#- #"
} >"$MANIFEST_FILE"

if [ -x "$SCRIPT_DIR/lilhouse-router-preview-validate" ]; then
  "$SCRIPT_DIR/lilhouse-router-preview-validate" "$PREVIEW_ROOT" >/dev/null
elif command -v lilhouse-router-preview-validate >/dev/null 2>&1; then
  lilhouse-router-preview-validate "$PREVIEW_ROOT" >/dev/null
else
  echo "Preview validator not found; skipping validation." >&2
fi

echo "LilHouse router wizard plan generated."
echo
echo "No system changes were made."
echo "Preview validation passed."
echo
echo "Interface report: $INTERFACE_REPORT"
echo "Plan JSON:        $PLAN_JSON"
echo "Plan summary:     $PLAN_SUMMARY"
echo
cat "$PLAN_SUMMARY"
