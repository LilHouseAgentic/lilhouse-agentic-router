#!/usr/bin/env python3
import argparse
import json
import hashlib
import sys
from pathlib import Path


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Verify a LilHouse router backup report and copied backup files."
    )
    parser.add_argument(
        "backup_dir",
        help="Backup directory containing backup-report.json.",
    )
    args = parser.parse_args()

    backup_dir = Path(args.backup_dir).resolve()
    report_path = backup_dir / "backup-report.json"

    if not report_path.is_file():
        print(f"ERROR: backup report not found: {report_path}", file=sys.stderr)
        return 1

    report = json.loads(report_path.read_text(encoding="utf-8"))

    errors = []
    verified = []
    missing = []

    for entry in report.get("entries", []):
        action = entry.get("action")
        target = Path(entry.get("backup_target", ""))

        if action == "missing":
            missing.append(entry.get("path"))
            continue

        if action == "file_copied":
            if not target.is_file():
                errors.append(f"missing copied file: {target}")
                continue

            expected = entry.get("source_sha256")
            actual = sha256_file(target)

            if expected and actual != expected:
                errors.append(f"sha256 mismatch: {target}")
                continue

            verified.append(entry.get("path"))
            continue

        if action == "directory_copied":
            if not target.is_dir():
                errors.append(f"missing copied directory: {target}")
                continue

            verified.append(entry.get("path"))
            continue

        errors.append(f"unknown action for {entry.get('path')}: {action}")

    result = {
        "schema": "lilhouse.router_backup_verify.v1",
        "backup_dir": str(backup_dir),
        "report": str(report_path),
        "ok": not errors,
        "verified_count": len(verified),
        "missing_source_count": len(missing),
        "error_count": len(errors),
        "verified_paths": verified,
        "missing_source_paths": missing,
        "errors": errors,
    }

    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if not errors else 1


if __name__ == "__main__":
    raise SystemExit(main())
