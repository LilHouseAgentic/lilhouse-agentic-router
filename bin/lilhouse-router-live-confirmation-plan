#!/usr/bin/env python3
import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path


CONFIRMATION_PHRASE = "I have local console access and accept temporary network interruption"


def load_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Plan the explicit confirmation gate required before future live router apply."
    )
    parser.add_argument("live_readiness_report", help="router live-readiness JSON.")
    parser.add_argument("--rollback-rehearsal-report", help="optional timed rollback rehearsal JSON.")
    args = parser.parse_args()

    readiness_path = Path(args.live_readiness_report).resolve()
    if not readiness_path.is_file():
        print(f"ERROR: live readiness report not found: {readiness_path}", file=sys.stderr)
        return 1

    readiness = load_json(readiness_path)

    rollback_report = None
    rollback_path = None
    if args.rollback_rehearsal_report:
        rollback_path = Path(args.rollback_rehearsal_report).resolve()
        if not rollback_path.is_file():
            print(f"ERROR: rollback rehearsal report not found: {rollback_path}", file=sys.stderr)
            return 1
        rollback_report = load_json(rollback_path)

    checks = []

    def check(name, ok, detail):
        checks.append({"name": name, "ok": bool(ok), "detail": detail})

    check(
        "readiness_schema",
        readiness.get("schema") == "lilhouse.router_live_readiness.v1",
        "input must be a live-readiness report",
    )
    check(
        "non_live_pipeline_proven",
        readiness.get("summary", {}).get("non_live_pipeline_proven") is True,
        "non-live pipeline must be proven first",
    )
    check(
        "readiness_not_live_ready",
        readiness.get("ready_for_live_apply") is False,
        "this gate must not bypass live readiness blockers",
    )
    check(
        "readiness_safe_to_apply_live_false",
        readiness.get("summary", {}).get("safe_to_apply_live") is False,
        "readiness must still block live apply",
    )

    if rollback_report is not None:
        check(
            "rollback_rehearsal_schema",
            rollback_report.get("schema") == "lilhouse.router_timed_rollback_rehearsal.v1",
            "rollback rehearsal report schema must match",
        )
        check(
            "rollback_rehearsal_ok",
            rollback_report.get("ok") is True,
            "rollback rehearsal must be OK",
        )
        check(
            "rollback_units_validated",
            rollback_report.get("summary", {}).get("rollback_units_validated") is True,
            "rollback units must validate in rehearsal",
        )
        check(
            "rollback_safe_to_apply_live_false",
            rollback_report.get("summary", {}).get("safe_to_apply_live") is False,
            "rollback rehearsal must still be non-live",
        )

    ok = all(c["ok"] for c in checks)

    result = {
        "schema": "lilhouse.router_live_confirmation_plan.v1",
        "mode": "live-confirmation-plan",
        "apply": False,
        "live_changes": False,
        "generated": datetime.now(timezone.utc).isoformat(),
        "ok": ok,
        "live_readiness_report": str(readiness_path),
        "rollback_rehearsal_report": str(rollback_path) if rollback_path else None,
        "checks": checks,
        "confirmation_policy": {
            "requires_local_console_or_physical_recovery": True,
            "requires_fresh_verified_backup": True,
            "requires_timed_rollback_armed_before_live_changes": True,
            "requires_post_apply_health_check": True,
            "requires_manual_rollback_cancel_after_health_pass": True,
            "requires_exact_confirmation_phrase": True,
            "confirmation_phrase": CONFIRMATION_PHRASE,
            "reject_plain_yes": True,
        },
        "summary": {
            "checks_passed": sum(1 for c in checks if c["ok"]),
            "checks_total": len(checks),
            "confirmation_gate_defined": True,
            "ready_for_live_apply": False,
            "safe_to_apply_live": False,
        },
    }

    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
