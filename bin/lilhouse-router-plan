#!/usr/bin/env bash
set -euo pipefail

python3 - "$@" <<'PY'
import argparse
import ipaddress
import json
import socket
import sys
from datetime import datetime, timezone

parser = argparse.ArgumentParser(
    description="Generate a LilHouse router deployment plan. This does not apply changes."
)

parser.add_argument("--wan", required=True, help="WAN interface name")
parser.add_argument("--lan", required=True, help="LAN interface name")
parser.add_argument("--lan-ip", required=True, help="Router LAN IP address")
parser.add_argument("--subnet", required=True, help="LAN subnet in CIDR form")
parser.add_argument("--dhcp-start", default="", help="DHCP range start")
parser.add_argument("--dhcp-end", default="", help="DHCP range end")
parser.add_argument("--dns-mode", default="pihole-unbound", choices=["pihole-unbound", "system"], help="DNS deployment mode")
parser.add_argument("--enable-cake", action="store_true", help="Plan CAKE/SQM setup")
parser.add_argument("--enable-ipv6", action="store_true", help="Plan IPv6 forwarding where available")
parser.add_argument("--output", default="", help="Optional file to write the JSON plan")

args = parser.parse_args()

errors = []
warnings = []

if args.wan == args.lan:
    errors.append("WAN and LAN interfaces must be different.")

try:
    subnet = ipaddress.ip_network(args.subnet, strict=False)
except ValueError as exc:
    errors.append(f"Invalid subnet: {exc}")
    subnet = None

try:
    lan_ip = ipaddress.ip_address(args.lan_ip)
except ValueError as exc:
    errors.append(f"Invalid LAN IP: {exc}")
    lan_ip = None

if subnet is not None and lan_ip is not None and lan_ip not in subnet:
    errors.append("LAN IP must be inside the LAN subnet.")

for label, value in [("dhcp_start", args.dhcp_start), ("dhcp_end", args.dhcp_end)]:
    if value:
        try:
            ip = ipaddress.ip_address(value)
            if subnet is not None and ip not in subnet:
                errors.append(f"{label} must be inside the LAN subnet.")
        except ValueError as exc:
            errors.append(f"Invalid {label}: {exc}")

if bool(args.dhcp_start) != bool(args.dhcp_end):
    errors.append("Both --dhcp-start and --dhcp-end must be provided together.")

plan = {
    "schema": "lilhouse.router_plan.v1",
    "generated_at": datetime.now(timezone.utc).astimezone().isoformat(),
    "host": socket.gethostname(),
    "apply": False,
    "mode": "router-deploy-plan-only",
    "summary": "Plan only. No system changes are made.",
    "inputs": {
        "wan_interface": args.wan,
        "lan_interface": args.lan,
        "lan_ip": args.lan_ip,
        "subnet": args.subnet,
        "dhcp_start": args.dhcp_start,
        "dhcp_end": args.dhcp_end,
        "dns_mode": args.dns_mode,
        "enable_cake": args.enable_cake,
        "enable_ipv6": args.enable_ipv6,
    },
    "validation": {
        "ok": not errors,
        "errors": errors,
        "warnings": warnings,
    },
    "planned_modules": [
        {
            "name": "interface_detection",
            "intent": "Confirm WAN and LAN interfaces exist before applying router configuration.",
            "risk": "low",
            "apply_status": "not_implemented",
        },
        {
            "name": "lan_static_address",
            "intent": "Configure the LAN interface with the requested static router address.",
            "risk": "high",
            "apply_status": "not_implemented",
            "planned_files": [
                "/etc/systemd/network/20-lilhouse-lan.network"
            ],
            "planned_settings": {
                "networkd_match_name": args.lan,
                "address": f"{args.lan_ip}/{subnet.prefixlen}" if subnet is not None else args.lan_ip,
                "dhcp_server": "planned_separately",
                "ipv6_accept_ra": False,
                "comment": "LAN static-address blueprint only. No files are written by this command."
            },
        },
        {
            "name": "forwarding",
            "intent": "Enable packet forwarding for router operation.",
            "risk": "high",
            "apply_status": "not_implemented",
            "planned_files": [
                "/etc/sysctl.d/90-lilhouse-router-forwarding.conf"
            ],
            "planned_settings": {
                "net.ipv4.ip_forward": 1,
                "net.ipv6.conf.all.forwarding": 1 if args.enable_ipv6 else 0,
                "ipv6_forwarding_requested": args.enable_ipv6,
                "comment": "Forwarding blueprint only. No sysctl files are written by this command."
            },
        },
        {
            "name": "firewall_nat",
            "intent": "Create a baseline firewall and outbound sharing rules.",
            "risk": "high",
            "apply_status": "not_implemented",
            "planned_files": [
                "/etc/nftables.conf",
                "/etc/systemd/system/nftables.service"
            ],
            "planned_settings": {
                "backend": "nftables",
                "wan_interface": args.wan,
                "lan_interface": args.lan,
                "lan_subnet": str(subnet) if subnet is not None else args.subnet,
                "default_input_policy": "drop_on_wan_allow_lan",
                "default_forward_policy": "drop_except_lan_to_wan",
                "nat": "masquerade_lan_to_wan",
                "allow_established_related": True,
                "allow_loopback": True,
                "allow_lan_to_router": True,
                "allow_wan_to_router": "minimal_dhcp_icmp_related_only",
                "comment": "Firewall/NAT blueprint only. No nftables files or rules are written by this command."
            },
        },
        {
            "name": "dns",
            "intent": "Configure the selected DNS mode.",
            "risk": "medium",
            "apply_status": "not_implemented",
            "planned_files": [
                "/etc/pihole/pihole.toml",
                "/etc/unbound/unbound.conf.d/lilhouse.conf"
            ],
            "planned_settings": {
                "mode": args.dns_mode,
                "lan_dns_address": args.lan_ip,
                "pihole_interface": args.lan,
                "pihole_listen": "lan_only",
                "unbound_listen": "127.0.0.1",
                "unbound_port": 5335,
                "pihole_upstream": "127.0.0.1#5335",
                "block_apple_private_relay": "planned",
                "block_doh_canary": "planned",
                "comment": "DNS blueprint only. No Pi-hole or Unbound settings are written by this command."
            },
        },
        {
            "name": "dhcp",
            "intent": "Configure DHCP service for LAN clients if requested.",
            "risk": "medium",
            "apply_status": "not_implemented",
            "planned_files": [
                "/etc/pihole/pihole.toml"
            ],
            "planned_settings": {
                "provider": "pihole-FTL",
                "interface": args.lan,
                "subnet": str(subnet) if subnet is not None else args.subnet,
                "router_ip": args.lan_ip,
                "dhcp_start": args.dhcp_start,
                "dhcp_end": args.dhcp_end,
                "enabled": bool(args.dhcp_start and args.dhcp_end),
                "authoritative": True,
                "comment": "DHCP blueprint only. No Pi-hole DHCP settings are written by this command."
            },
        },
        {
            "name": "worker_timers",
            "intent": "Enable LilHouse observe and health workers.",
            "risk": "low",
            "apply_status": "observe_only_available",
        },
    ],
}

if args.enable_cake:
    plan["planned_modules"].append({
        "name": "cake_sqm",
        "intent": "Plan CAKE/SQM setup for latency control.",
        "risk": "medium",
        "apply_status": "not_implemented",
    })

if args.enable_ipv6:
    plan["planned_modules"].append({
        "name": "ipv6_forwarding",
        "intent": "Plan IPv6 forwarding where the upstream provides IPv6.",
        "risk": "medium",
        "apply_status": "not_implemented",
    })

text = json.dumps(plan, indent=2, sort_keys=True) + "\n"

if args.output:
    with open(args.output, "w", encoding="utf-8") as handle:
        handle.write(text)
    print(args.output)
else:
    print(text, end="")

sys.exit(0 if not errors else 2)
PY
