#!/usr/bin/env python3
import argparse
import json
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def run_json(cmd):
    out = subprocess.check_output(cmd, text=True, stderr=subprocess.STDOUT)
    return json.loads(out)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run full non-live timed rollback rehearsal."
    )
    parser.add_argument("--out-dir", required=True)
    parser.add_argument("--source-root", required=True)
    parser.add_argument("--unit-target-root", required=True)
    parser.add_argument("--rollback-root", default="/")
    parser.add_argument("--timeout-minutes", type=int, default=5)
    args = parser.parse_args()

    script_dir = Path(__file__).resolve().parent
    out_dir = Path(args.out_dir).resolve()
    source_root = Path(args.source_root).resolve()
    unit_target_root = Path(args.unit_target_root).resolve()
    rollback_root = Path(args.rollback_root).resolve()

    if str(unit_target_root) == "/":
        print("ERROR: refusing to write rollback rehearsal units into live /", file=sys.stderr)
        return 2

    out_dir.mkdir(parents=True, exist_ok=True)
    backup_dir = out_dir / "backup"

    backup_create = run_json([
        str(script_dir / "lilhouse-router-backup-create"),
        "--root", str(source_root),
        "--backup-dir", str(backup_dir),
        "--yes",
    ])

    backup_verify = run_json([
        str(script_dir / "lilhouse-router-backup-verify"),
        str(backup_dir),
    ])

    rollback_plan_path = out_dir / "timed-rollback-plan.json"
    rollback_plan = run_json([
        str(script_dir / "lilhouse-router-timed-rollback-plan"),
        "--backup-dir", str(backup_dir),
        "--rollback-root", str(rollback_root),
        "--timeout-minutes", str(args.timeout_minutes),
    ])
    rollback_plan_path.write_text(json.dumps(rollback_plan, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    rollback_create = run_json([
        str(script_dir / "lilhouse-router-timed-rollback-create"),
        str(rollback_plan_path),
        "--target-root", str(unit_target_root),
        "--yes",
    ])

    rollback_validate = run_json([
        str(script_dir / "lilhouse-router-timed-rollback-validate"),
        str(unit_target_root),
    ])

    ok = (
        backup_create.get("schema") == "lilhouse.router_backup_create.v1"
        and backup_verify.get("ok") is True
        and rollback_plan.get("ok") is True
        and rollback_create.get("ok") is True
        and rollback_validate.get("ok") is True
    )

    result = {
        "schema": "lilhouse.router_timed_rollback_rehearsal.v1",
        "mode": "timed-rollback-rehearsal",
        "apply": False,
        "live_changes": False,
        "live_root_allowed": False,
        "generated": datetime.now(timezone.utc).isoformat(),
        "out_dir": str(out_dir),
        "source_root": str(source_root),
        "backup_dir": str(backup_dir),
        "unit_target_root": str(unit_target_root),
        "rollback_root": str(rollback_root),
        "ok": ok,
        "summary": {
            "backup_created": backup_create.get("summary", {}).get("copied", 0) >= 1,
            "backup_verified": backup_verify.get("ok") is True,
            "rollback_plan_ok": rollback_plan.get("ok") is True,
            "rollback_units_created": rollback_create.get("ok") is True,
            "rollback_units_validated": rollback_validate.get("ok") is True,
            "rollback_checks_passed": rollback_validate.get("summary", {}).get("checks_passed"),
            "rollback_checks_total": rollback_validate.get("summary", {}).get("checks_total"),
            "safe_to_apply_live": False,
        },
        "reports": {
            "backup_create": backup_create,
            "backup_verify": backup_verify,
            "rollback_plan": rollback_plan,
            "rollback_create": rollback_create,
            "rollback_validate": rollback_validate,
        },
    }

    report_path = out_dir / "timed-rollback-rehearsal-report.json"
    report_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
